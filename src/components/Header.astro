---
import { getCategorias, getDestacadas, noticiasVisibles } from '../lib/noticias';
import { NOTICIAS_MODO_PREVIA } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const H = `${base}/#`;
const mostrarNoticias = NOTICIAS_MODO_PREVIA || noticiasVisibles.length > 0;
const noticiasMenu = getDestacadas(3);
const categoriasMenu = getCategorias().filter((categoria) => categoria.count > 0);
---
<header class="fixed top-0 inset-x-0 z-50">  <div id="topbar" class="relative bg-[#0B1220] border-b border-[rgba(0,240,255,.12)]">
    <div class="wrap h-full flex items-center justify-between gap-2 relative z-10">
      <div class="tb-left">
        <a id="topEmail" href="mailto:hola@fractalhost.cl" aria-label="Enviar correo a hola@fractalhost.cl" title="hola@fractalhost.cl" class="tb-plain">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" class="w-4 h-4 stroke-current" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          <span class="tb-email-text hidden xl:inline">hola@fractalhost.cl</span>
        </a>
        <a href="https://clientes.fractalhost.cl/serverstatus.php" target="_blank" rel="noopener noreferrer" aria-label="Ver estado de servidores" title="Estado de servidores" class="tb-plain">
          <span class="tb-dot animate-pulse" aria-hidden="true"></span>
          <span class="tb-status-text hidden xl:inline">Estado de servidores</span>
        </a>
      </div>

      <div class="tb-right">
        {/* Secundarias: utilidades de cliente, discretas y agrupadas */}
        <div class="tb-sec">
          <a href="https://calendar.app.google/W9CqbvXdKMzcAWHN8" target="_blank" rel="noopener noreferrer" aria-label="Agendar videollamada de 15 minutos" title="Agendar videollamada" class="tb-link">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" class="w-4 h-4 stroke-current" aria-hidden="true"><rect x="2" y="6" width="13" height="12" rx="2"/><path d="M15 10.5l7-3.5v10l-7-3.5z"/></svg>
            <span class="hidden xl:inline">Agendar videollamada</span>
          </a>
          <a href="https://clientes.fractalhost.cl/" target="_blank" rel="noopener noreferrer" aria-label="Área clientes" title="Área clientes" class="tb-link">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" class="w-4 h-4 stroke-current" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>
            <span class="hidden xl:inline">Área clientes</span>
          </a>
        </div>
        {/* Separador: fin de lo secundario, inicio de la acción */}
        <span class="tb-sep hidden md:block" aria-hidden="true"></span>
        <a href={`${base}/cotizador/`} aria-label="Cotizar sitio web" title="Cotizar sitio web" class="tb-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" class="w-4 h-4 stroke-current" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 12h4M8 15h4M15 12h.01M15 15h.01"/></svg>
          <span class="hidden xl:inline">Cotizar sitio web</span>
          <span class="xl:hidden">Cotizar</span>
        </a>
        <div class="tb-drop" id="tbContratar">
          <button type="button" id="tbContratarBtn" class="tb-drop-btn" aria-haspopup="true" aria-expanded="false" aria-controls="tbContratarMenu" aria-label="Ver planes y contratar hosting en línea">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" class="w-4 h-4 stroke-current" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3.5h2.6l2.3 11.2a1.7 1.7 0 001.7 1.4h8.4a1.7 1.7 0 001.7-1.3l1.4-6.3H6"/></svg>
            <span class="hidden lg:inline">Contratar</span>
            <svg viewBox="0 0 24 24" fill="none" stroke-width="3" class="tb-chev" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div id="tbContratarMenu" class="tb-drop-menu" role="menu" aria-label="Carrito de compra">
            <span class="tb-drop-arrow" aria-hidden="true"></span>
            <div class="tb-cart-head">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" class="tb-cart-ico" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3.5h2.6l2.3 11.2a1.7 1.7 0 001.7 1.4h8.4a1.7 1.7 0 001.7-1.3l1.4-6.3H6"/></svg>
              <span class="tb-cart-title">Su carrito</span>
              <span class="tb-cart-count">0</span>
            </div>
            <p class="tb-cart-empty">Aún no ha agregado planes a su carrito.</p>
            <a href="https://clientes.fractalhost.cl/store/planes" role="menuitem" class="tb-cart-cta">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" class="tb-cart-ico" aria-hidden="true"><path d="M5 7h14l-1.2 10.2a2 2 0 01-2 1.8H8.2a2 2 0 01-2-1.8L5 7z"/><path d="M9 7V5.5a3 3 0 016 0V7"/></svg>
              <span>Contratar hosting</span>
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" class="tb-cart-go" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </a>
            <p class="tb-cart-note">Pago online con Webpay y activación automática · 3 cuotas sin interés.</p>
          </div>
        </div>
        <button id="themeBtn" class="tb-theme" aria-label="Cambiar entre página clara y oscura" title="Cambiar tema">
          <svg class="w-4 h-4 dark:hidden stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
          <svg class="hidden dark:block w-4 h-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </div>
  </div>
<div class="bg-gradient-to-b from-night/95 to-darksec/95 backdrop-blur-md border-b border-cy/10 shadow-[0_10px_40px_rgba(0,0,0,.45)]">
    <div class="wrap h-[70px] flex items-center justify-between gap-4 relative z-20">
      <a href={`${H}inicio`} aria-label="Fractal Host, ir al inicio">
        <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logo.webp`} alt="Fractal Host" width="148" height="44" class="h-[44px] w-auto object-contain drop-shadow-[0_0_8px_rgba(0,229,255,.55)]" />
      </a>
      <nav class="hidden lg:flex items-center gap-7" aria-label="Navegación principal">
        <a href={`${H}inicio`} class="nav-inicio font-display text-[.8rem] font-bold tracking-[.12em] uppercase text-[#E6EDF5] hover:text-cyt transition-colors">Inicio</a>
        <a href={`${base}/hosting-global/`} data-drop="global" class="drop-btn cursor-pointer flex items-center gap-1.5 font-display text-[.8rem] font-bold tracking-[.12em] uppercase text-[#E6EDF5] hover:text-cyt transition-colors">Hosting Global<svg class="chev w-3 h-3 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="3" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
        <a href={`${base}/hosting-cono-sur/`} data-drop="nacional" class="drop-btn cursor-pointer flex items-center gap-1.5 font-display text-[.8rem] font-bold tracking-[.12em] uppercase text-[#E6EDF5] hover:text-cyt transition-colors">Hosting Nacional<svg class="chev w-3 h-3 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="3" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
        <a href={`${base}/servicios/`} data-drop="servicios" class="drop-btn cursor-pointer flex items-center gap-1.5 font-display text-[.8rem] font-bold tracking-[.12em] uppercase text-[#E6EDF5] hover:text-cyt transition-colors">Servicios<svg class="chev w-3 h-3 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="3" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
        <a href={`${base}/sitios-web/`} data-drop="webs" class="drop-btn cursor-pointer flex items-center gap-1.5 font-display text-[.8rem] font-bold tracking-[.12em] uppercase text-[#E6EDF5] hover:text-cyt transition-colors">Sitios Web<svg class="chev w-3 h-3 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="3" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
        {mostrarNoticias && (
          <a href={`${base}/noticias/`} data-drop="noticias" class="drop-btn cursor-pointer flex items-center gap-1.5 font-display text-[.8rem] font-bold tracking-[.12em] uppercase text-[#E6EDF5] hover:text-cyt transition-colors">Noticias<svg class="chev w-3 h-3 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="3" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
        )}
        <a href={`${H}contacto`} data-drop="contacto" class="drop-btn cursor-pointer flex items-center gap-1.5 font-display text-[.8rem] font-bold tracking-[.12em] uppercase text-[#E6EDF5] hover:text-cyt transition-colors">Contacto<svg class="chev w-3 h-3 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="3" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
      </nav>
      <button id="burger" class="lg:hidden p-2" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileMenu"><span class="block w-6 h-0.5 bg-white my-[5px]"></span><span class="block w-6 h-0.5 bg-white my-[5px]"></span><span class="block w-6 h-0.5 bg-white my-[5px]"></span></button>
    </div>
  </div>

  <div data-drop-panel="global" class="mega-panel absolute top-full w-[92%] max-w-[880px] z-10 p-6">
    <span class="mega-arrow" aria-hidden="true"></span>
    <div class="grid lg:grid-cols-2 gap-5">
      <div class="mega-card" data-goto="#hosting-global">
        <span class="font-display text-[.68rem] font-extrabold tracking-[.2em] uppercase text-cydeep">cPanel · Datacenter EE. UU.</span>
        <p class="font-display font-extrabold text-txt text-[1.08rem] mt-2 mb-2">Hosting Global compartido</p>
        <p class="text-[.88rem] text-mut mb-4">cPanel completo, SSL, correos y WordPress optimizado con LiteSpeed.</p>
        <div class="flex flex-wrap gap-2 mb-4">
          <a href={`${base}/hosting-global/#planes`} data-mega-link class="mega-link">Starter 1–3</a>
          <a href={`${base}/hosting-global/#planes`} data-mega-link class="mega-link">Pro 1–3</a>
          <a href={`${base}/hosting-global/#planes`} data-mega-link class="mega-link">Master 1–3</a>
        </div>
        <div class="flex flex-wrap gap-1.5 text-[.76rem] text-mut">
          <span class="border border-line rounded-full px-2.5 py-1">SSL gratis</span><span class="border border-line rounded-full px-2.5 py-1">Datacenter EE. UU.</span><span class="border border-line rounded-full px-2.5 py-1">LiteSpeed Cache</span><span class="border border-line rounded-full px-2.5 py-1">Imunify360</span>
        </div>
        <a href={`${base}/hosting-global/`} data-mega-link class="mt-4 inline-flex text-[.84rem] font-bold text-cydeep hover:text-ink">Ver Hosting Global →</a>
      </div>
      <div class="mega-card" data-goto="#hosting-global">
        <span class="font-display text-[.68rem] font-extrabold tracking-[.2em] uppercase text-cydeep">Precios por año</span>
        <p class="font-display font-extrabold text-txt text-[1.08rem] mt-2 mb-4">Planes desde</p>
        <ul class="flex flex-col gap-2.5 mb-4">
          <li><a href="https://clientes.fractalhost.cl/store/planes" target="_blank" rel="noopener noreferrer" data-mega-link class="mega-link w-full justify-between">Starter <b class="text-cydeep">desde $39.990</b></a></li>
          <li><a href="https://clientes.fractalhost.cl/store/planes" target="_blank" rel="noopener noreferrer" data-mega-link class="mega-link w-full justify-between">Pro <b class="text-cydeep">desde $86.990</b></a></li>
          <li><a href="https://clientes.fractalhost.cl/store/planes" target="_blank" rel="noopener noreferrer" data-mega-link class="mega-link w-full justify-between">Master <b class="text-cydeep">desde $179.990</b></a></li>
        </ul>
        <p class="text-[.84rem] text-mut">2 años −6% · 3 años −12% sobre el valor anual.</p>
      </div>
    </div>
  </div>

  <div data-drop-panel="nacional" class="mega-panel absolute top-full w-[92%] max-w-[880px] z-10 p-6">
    <span class="mega-arrow" aria-hidden="true"></span>
    <div class="grid lg:grid-cols-2 gap-5">
      <div class="mega-card" data-goto="#hosting-nacional">
        <span class="font-display text-[.68rem] font-extrabold tracking-[.2em] uppercase text-cydeep">Cono Sur · Panel Ferozo</span>
        <p class="font-display font-extrabold text-txt text-[1.08rem] mt-2 mb-3">Hosting Cono Sur</p>
        <p class="text-[.88rem] text-mut mb-4">Servidores en el Cono Sur: <b class="text-txt">150–200 ms menos de ping</b> para sus visitantes en Chile.</p>
        <div class="mb-3">
          <div class="flex justify-between text-[.84rem] mb-1.5 text-txt"><span>EE. UU.</span><span class="text-mut">~240 ms</span></div>
          <div class="h-2 rounded-full bg-page overflow-hidden"><div class="h-full w-[92%] rounded-full bg-[#9AA7B8]"></div></div>
        </div>
        <div>
          <div class="flex justify-between text-[.84rem] mb-1.5 text-txt"><span>Cono Sur</span><span class="text-okd font-bold">~60 ms</span></div>
          <div class="h-2 rounded-full bg-page overflow-hidden"><div class="h-full w-[22%] rounded-full bg-gradient-to-r from-cydeep to-ok"></div></div>
        </div>
      </div>
      <div class="mega-card" data-goto="#hosting-nacional">
        <span class="font-display text-[.68rem] font-extrabold tracking-[.2em] uppercase text-cydeep">Planes por año</span>
        <p class="font-display font-extrabold text-txt text-[1.08rem] mt-2 mb-4">Elija su plan austral</p>
        <ul class="grid sm:grid-cols-2 gap-2.5 mb-4">
          <li><a href="https://clientes.fractalhost.cl/store/enlace-nacional-patagonia-cloud-server/austral" target="_blank" rel="noopener noreferrer" data-mega-link class="mega-link w-full justify-between">Austral <b class="text-cydeep">$49.990</b></a></li>
          <li><a href="https://clientes.fractalhost.cl/store/enlace-nacional-patagonia-cloud-server/glaciar" target="_blank" rel="noopener noreferrer" data-mega-link class="mega-link w-full justify-between">Glaciar <b class="text-cydeep">$69.990</b></a></li>
          <li><a href="https://clientes.fractalhost.cl/store/enlace-nacional-patagonia-cloud-server/fiordo" target="_blank" rel="noopener noreferrer" data-mega-link class="mega-link w-full justify-between">Fiordo <b class="text-cydeep">$89.990</b></a></li>
          <li><a href="https://clientes.fractalhost.cl/store/enlace-nacional-patagonia-cloud-server/fiordo-extra" target="_blank" rel="noopener noreferrer" data-mega-link class="mega-link w-full justify-between">Fiordo Extra <b class="text-cydeep">$129.990</b></a></li>
        </ul>
        <div class="flex flex-wrap gap-1.5 text-[.76rem] text-mut">
          <span class="border border-line rounded-full px-2.5 py-1">~60 ms ping</span><span class="border border-line rounded-full px-2.5 py-1">Panel Ferozo</span><span class="border border-line rounded-full px-2.5 py-1">SSL gratis</span>
        </div>
        <a href={`${base}/hosting-cono-sur/`} data-mega-link class="mt-4 inline-flex text-[.84rem] font-bold text-cydeep hover:text-ink">Ver Hosting Cono Sur →</a>
      </div>
    </div>
  </div>

  <div data-drop-panel="servicios" class="mega-panel absolute top-full w-[92%] max-w-[1040px] z-10 p-6">
    <span class="mega-arrow" aria-hidden="true"></span>
    <div class="grid lg:grid-cols-3 gap-5">
      <div class="mega-card" data-goto="#correo">
        <span class="font-display text-[.68rem] font-extrabold tracking-[.2em] uppercase text-cydeep">Correo corporativo</span>
        <p class="font-display font-extrabold text-txt text-[1.08rem] mt-2 mb-2">Correo con el nombre de su empresa</p>
        <p class="text-[.88rem] text-mut mb-4">Cuentas @suempresa.cl configuradas por nosotros en Gmail, Outlook o su celular.</p>
        <div class="flex flex-wrap gap-2">
          <a href={`${base}/correo-corporativo/`} data-mega-link class="mega-link">Correo con su dominio</a>
          <a href={`${base}/correo-corporativo/`} data-mega-link class="mega-link">Gmail con su dominio</a>
        </div>
      </div>
      <div class="mega-card" data-goto="#mantencion">
        <span class="font-display text-[.68rem] font-extrabold tracking-[.2em] uppercase text-cydeep">Mantención web</span>
        <p class="font-display font-extrabold text-txt text-[1.08rem] mt-2 mb-2">Mantención, respaldos y monitoreo</p>
        <p class="text-[.88rem] text-mut mb-4">Actualizaciones, SSL vigente y soporte directo. Servicio independiente del hosting.</p>
        <div class="flex flex-wrap gap-2">
          <a href={`${base}/mantencion-web/`} data-mega-link class="mega-link">Ver mantención web</a>
          <a href={`${base}/cotizador/`} data-mega-link class="mega-link border-yel/60 text-[#8a6d00] font-bold">Cotizar mantención</a>
        </div>
      </div>
      <div class="mega-card" data-goto="#mantencion">
        <span class="font-display text-[.68rem] font-extrabold tracking-[.2em] uppercase text-cydeep">Seguridad y datos</span>
        <p class="font-display font-extrabold text-txt text-[1.08rem] mt-2 mb-2">Seguridad informática y Ley 21.719</p>
        <p class="text-[.88rem] text-mut mb-4">Desinfección de sitios hackeados y adecuación técnica de protección de datos.</p>
        <div class="flex flex-wrap gap-2">
          <a href={`${base}/seguridad-informatica/`} data-mega-link class="mega-link">Seguridad informática</a>
          <a href={`${base}/ley-21719/`} data-mega-link class="mega-link">Adecuación Ley 21.719</a>
        </div>
      </div>
    </div>
    <div class="mt-4 pt-4 border-t border-line flex flex-wrap items-center justify-between gap-2">
      <a href={`${base}/servicios/`} data-mega-link class="text-[.84rem] font-bold text-cydeep hover:text-ink">Ver todos los servicios →</a>
      <a href={`${base}/cotizador/`} data-mega-link class="text-[.84rem] font-bold text-cydeep hover:text-ink">Cotizar un servicio →</a>
    </div>
  </div>

  <div data-drop-panel="webs" class="mega-panel absolute top-full w-[92%] max-w-[1040px] z-10 p-6">
    <span class="mega-arrow" aria-hidden="true"></span>
    <div class="grid lg:grid-cols-3 gap-5">
      <div class="mega-card lg:col-span-2" data-goto="#sitios-web">
        <span class="font-display text-[.68rem] font-extrabold tracking-[.2em] uppercase text-cydeep">Creación de sitios web en Punta Arenas</span>
        <p class="font-display font-extrabold text-txt text-[1.08rem] mt-2 mb-4">¿Qué tipo de sitio necesita?</p>
        <div class="grid sm:grid-cols-2 gap-2.5">
          <a href={`${base}/sitios-web/micrositio/`} data-mega-link class="mega-link">Micrositio · 24 h</a>
          <a href={`${base}/sitios-web/one-page/`} data-mega-link class="mega-link">One Page / simple · 3 a 7 días</a>
          <a href={`${base}/sitios-web/sitio-corporativo/`} data-mega-link class="mega-link">Sitio de empresa · 1 a 3 semanas</a>
          <a href={`${base}/sitios-web/tienda-online/`} data-mega-link class="mega-link">Tienda en línea · 15 a 45 días</a>
          <a href={`${base}/sitios-web/eventos-y-entradas/`} data-mega-link class="mega-link">Eventos y entradas</a>
          <a href={`${base}/sitios-web/reserva-de-horas/`} data-mega-link class="mega-link">Reserva de horas</a>
          <a href={`${base}/sitios-web/sitio-inmobiliario/`} data-mega-link class="mega-link">Sitio inmobiliario</a>
          <a href={`${base}/sitios-web/sitio-a-medida/`} data-mega-link class="mega-link">Proyecto a medida</a>
        </div>
      </div>
      <div class="mega-card" data-goto="#sitios-web">
        <span class="font-display text-[.68rem] font-extrabold tracking-[.2em] uppercase text-cydeep">Empiece hoy</span>
        <p class="font-display font-extrabold text-txt text-[1.08rem] mt-2 mb-4">Cotice o converse</p>
        <ul class="flex flex-col gap-3 mb-4">
          <li><a href={`${base}/cotizador/`} data-mega-link class="flex items-center gap-3 text-[.9rem] text-[#8a6d00] hover:text-ink font-bold transition-colors"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" class="w-4 h-4 stroke-yelhov shrink-0" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h3M8 15h3M14 11h2M14 15h2"/></svg>Usar el cotizador de sitios web<svg viewBox="0 0 24 24" fill="none" stroke-width="2" class="w-3.5 h-3.5 stroke-current ml-auto" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></a></li>
          <li><a href="https://calendar.app.google/W9CqbvXdKMzcAWHN8" target="_blank" rel="noopener noreferrer" data-mega-link class="flex items-center gap-3 text-[.9rem] text-txt hover:text-cydeep transition-colors"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" class="w-4 h-4 stroke-cydeep shrink-0" aria-hidden="true"><rect x="2" y="6" width="13" height="12" rx="2"/><path d="M15 10.5l7-3.5v10l-7-3.5z"/></svg>Agendar videollamada de 15 minutos</a></li>
        </ul>
        <ul class="flex flex-col gap-2 text-[.86rem] text-mut">
          <li class="flex gap-2 items-center"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" class="w-4 h-4 stroke-okd shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Micrositio listo en 24 h</li>
          <li class="flex gap-2 items-center"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" class="w-4 h-4 stroke-okd shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Primer año de hosting gratis</li>
