---
import webpay from '../assets/pagos/logo_webpay_CL_100x64_8540b711a5.png';
import visa from '../assets/pagos/logo_visa_MX_100x64_9dfa098b9c.png';
import mastercard from '../assets/pagos/logo_mastercard_PE_100x64_6f90d7af88.png';
import redcompra from '../assets/pagos/logo_redcompra_CL_100x64_42e4ed7eef.png';
import khipu from '../assets/pagos/logo_khipu_bancos100.png';
import etpay from '../assets/pagos/etpay_png_9ade6942d2.png';
import billeteras from '../assets/pagos/logo_billeteras_CL_80x64_57c620ad9a.png';
import mach from '../assets/pagos/logo_mach.png';

/* En un .astro el import de una imagen devuelve un ImageMetadata {src,width,height}
   y no una cadena: si se cuela en src="…" sale "[object Object]" y el logo no carga. */
const medio = (img: any, alt: string) => ({
  src: typeof img === 'string' ? img : img.src,
  alt,
  w: (img && img.width) || 80,
  h: (img && img.height) || 64,
});


/* Orden fijo pedido: Webpay, Visa, Mastercard, Redcompra, Khipu, ETPay,
   Billeteras digitales, Bci | MACH. */
const medios = [
  medio(webpay, 'Webpay'),
  medio(visa, 'Visa'),
  medio(mastercard, 'Mastercard'),
  medio(redcompra, 'Redcompra'),
  medio(khipu, 'Khipu'),
  medio(etpay, 'ETPay'),
  medio(billeteras, 'Billeteras digitales'),
  medio(mach, 'Bci | MACH'),
];
---

<section id="contrata-en-linea" class="on-dark relative bg-deep noise gridlines inner-depth text-[#EAF1F8] py-[64px] overflow-hidden">
  <div data-px="0.08" class="absolute -top-24 right-[8%] w-[420px] h-[420px] rounded-full bg-cy/12 blur-[130px] z-0" aria-hidden="true"></div>
  <div data-px="-0.05" class="absolute bottom-[-120px] left-[4%] w-[420px] h-[420px] rounded-full bg-[#1B74E4]/18 blur-[140px] z-0" aria-hidden="true"></div>

  <div class="relative z-10 wrap">
    <div class="text-center reveal">
      <h2 class="font-display font-extrabold uppercase tracking-[.03em] text-[clamp(1.45rem,3.1vw,2.25rem)] text-white">Contrata y paga en línea</h2>

      <div class="mt-6 mx-auto max-w-[860px] rounded-xl bg-[#E6F0F7] px-5 py-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-3">
        {medios.map((m) => (
          <img src={m.src} alt={m.alt} width={m.w} height={m.h} loading="lazy" decoding="async"
               class="h-[60px] w-auto max-w-full object-contain grayscale opacity-90" />
        ))}
      </div>

      <p class="mt-5 mx-auto max-w-[640px] text-[.98rem] leading-relaxed text-[#B7C4D4]">Serás redireccionado a nuestro carrito de compra. Ahí indicas tu dominio y completas los datos de tu empresa. También puedes pagar por depósito o transferencia.</p>

      <a href="https://clientes.fractalhost.cl/store/planes" class="mt-7 inline-flex items-center gap-2 border border-cy/60 bg-transparent hover:bg-cy/10 hover:border-cy text-cyt font-display font-bold text-[.95rem] px-8 py-3.5 rounded-md transition-colors duration-200">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" class="w-5 h-5 stroke-current shrink-0" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3.5h2.6l2.3 11.2a1.7 1.7 0 001.7 1.4h8.4a1.7 1.7 0 001.7-1.3l1.4-6.3H6"/></svg>
        Ver planes y contratar
      </a>
    </div>
  </div>
</section>
