---
import PlanCard from './PlanCard.astro';
import { hostingGlobal } from '../data/planes';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="hosting-global" class="relative overflow-hidden bg-pagesoft dark:bg-paged py-[88px] transition-colors duration-300">
  <svg data-px="0.05" class="watermark -right-8 top-14 w-[430px] opacity-[.07] dark:opacity-[.09]" viewBox="0 0 200 140" fill="none" stroke="#00A9C4" stroke-width="2" aria-hidden="true"><rect x="4" y="8" width="192" height="128" rx="10"/><path d="M4 30h192"/><circle cx="16" cy="19" r="3"/><circle cx="28" cy="19" r="3"/><circle cx="40" cy="19" r="3"/><rect x="52" y="15" width="120" height="8" rx="4"/><rect x="20" y="46" width="70" height="40" rx="6"/><rect x="104" y="46" width="76" height="10" rx="5"/><rect x="104" y="64" width="60" height="8" rx="4"/><rect x="20" y="98" width="160" height="20" rx="6"/></svg>
  <div class="wrap relative z-10">
    <div class="max-w-[860px] mx-auto text-center mb-12 reveal">
      <span class="kicker">cPanel · Datacenter EE. UU.</span>
      <h2 class="font-display font-extrabold uppercase text-[clamp(1.45rem,3.1vw,2.25rem)] leading-snug mt-4 mb-3">Hosting Global con cPanel para WordPress</h2>
      <p class="text-mut dark:text-mutd text-[1rem]">Elige la línea según el tamaño de tu proyecto. Todos los planes incluyen SSL, correos, respaldos diarios y migración gratis desde tu antiguo proveedor. <a class="text-cydeep dark:text-cyt font-bold underline underline-offset-4" href={`${base}/migraciones.html`}>Conoce cómo funciona la migración sin costo de tu sitio y correos →</a></p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-4 mb-10 reveal">
      <div role="tablist" aria-label="Líneas de Hosting Global" class="flex gap-1.5 bg-white dark:bg-cardd border border-line dark:border-lined rounded-xl p-1.5 shadow-md">
        <button role="tab" id="tab-starter" aria-selected="true" aria-controls="panel-starter" data-tab-btn="starter" tabindex="0" class="tabbtn active">Starter</button>
        <button role="tab" id="tab-pro" aria-selected="false" aria-controls="panel-pro" data-tab-btn="pro" tabindex="-1" class="tabbtn">Pro</button>
        <button role="tab" id="tab-master" aria-selected="false" aria-controls="panel-master" data-tab-btn="master" tabindex="-1" class="tabbtn">Master</button>
      </div>
      <div class="flex gap-1.5 items-center" role="group" aria-label="Duración de contratación Hosting Global">
        <button data-cycle-btn data-cycle-target="#plansGrid" data-cycle="annual" class="cyc active bg-white dark:bg-cardd border border-line dark:border-lined rounded-full px-4 py-2 text-[.86rem] font-medium">1 año <span class="text-mut dark:text-mutd font-bold">0%</span></button>
        <button data-cycle-btn data-cycle-target="#plansGrid" data-cycle="biennial" class="cyc bg-white dark:bg-cardd border border-line dark:border-lined rounded-full px-4 py-2 text-[.86rem] font-medium">2 años <span class="text-okd dark:text-live font-bold">-6%</span></button>
        <button data-cycle-btn data-cycle-target="#plansGrid" data-cycle="triennial" class="cyc bg-white dark:bg-cardd border border-line dark:border-lined rounded-full px-4 py-2 text-[.86rem] font-medium">3 años <span class="text-okd dark:text-live font-bold">-12%</span></button>
      </div>
    </div>
    <div id="plansGrid" class="plans-gridwrap relative z-10">
      <div id="panel-starter" role="tabpanel" aria-labelledby="tab-starter" data-tab-panel="starter" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 items-stretch tab-in"><h3 class="sr-only">Línea Starter</h3>
        {hostingGlobal.starter.map((p) => <PlanCard plan={p} tag="h4" />)}
      </div>
      <div id="panel-pro" role="tabpanel" aria-labelledby="tab-pro" data-tab-panel="pro" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 items-stretch" hidden><h3 class="sr-only">Línea Pro</h3>
        {hostingGlobal.pro.map((p) => <PlanCard plan={p} tag="h4" />)}
      </div>
      <div id="panel-master" role="tabpanel" aria-labelledby="tab-master" data-tab-panel="master" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 items-stretch" hidden><h3 class="sr-only">Línea Master</h3>
        {hostingGlobal.master.map((p) => <PlanCard plan={p} tag="h4" />)}
      </div>
    </div>
    <p class="mt-7 text-center text-[.88rem] leading-relaxed text-mut dark:text-mutd reveal">Renovación anual: te avisamos 15 días antes. Si pasan 15 días sin renovar, el servicio se suspende; a los 120 días sin pago, el sitio se elimina de forma permanente. <a class="text-cydeep dark:text-cyt font-bold underline underline-offset-4" href="#faq">Ver detalles en preguntas frecuentes →</a></p>
    <div class="mt-9 reveal">
      <div class="flex flex-wrap justify-center gap-2.5">
        <span tabindex="0" class="tip inline-flex items-center gap-2 bg-white dark:bg-cardd border border-line dark:border-lined rounded-full px-4 py-2 text-[.86rem] font-bold text-txt dark:text-txtd shadow-sm" data-tip-place="above" data-tip="Cifra la conexión entre tu sitio y tus visitantes. Genera confianza, protege los datos y mejora tu posicionamiento."><svg viewBox="0 0 24 24" fill="none" stroke-width="2" class="w-4 h-4 stroke-cydeep dark:stroke-cyt" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>SSL Gratis</span>
        <span tabindex="0" class="tip inline-flex items-center gap-2 bg-white dark:bg-cardd border border-line dark:border-lined rounded-full px-4 py-2 text-[.86rem] font-bold text-txt dark:text-txtd shadow-sm" data-tip-place="above" data-tip="Servidores en Estados Unidos con conectividad global: ideales si tu audiencia es internacional."><svg viewBox="0 0 24 24" fill="none" stroke-width="2" class="w-4 h-4 stroke-cydeep dark:stroke-cyt" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9s1.3-6.4 3.8-9z"/></svg>Datacenter EE. UU.</span>
        <span tabindex="0" class="tip inline-flex items-center gap-2 bg-white dark:bg-cardd border border-line dark:border-lined rounded-full px-4 py-2 text-[.86rem] font-bold text-txt dark:text-txtd shadow-sm" data-tip-place="above" data-tip="Servidor web de alto rendimiento con caché integrada: tu sitio carga más rápido."><svg viewBox="0 0 24 24" fill="none" stroke-width="2" class="w-4 h-4 stroke-cydeep dark:stroke-cyt" aria-hidden="true"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg>LiteSpeed Cache</span>
        <span tabindex="0" class="tip inline-flex items-center gap-2 bg-white dark:bg-cardd border border-line dark:border-lined rounded-full px-4 py-2 text-[.86rem] font-bold text-txt dark:text-txtd shadow-sm" data-tip-place="above" data-tip="Protección automática contra hackeos, malware y ataques, en tiempo real."><svg viewBox="0 0 24 24" fill="none" stroke-width="2" class="w-4 h-4 stroke-cydeep dark:stroke-cyt" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/></svg>Imunify360</span>
      </div>
    </div>
  </div>
</section>
