<!-- ============ H2 CONTACTO ============ -->
<section id="contacto" class="py-[88px]">
  <div class="wrap">
    <div class="max-w-[860px] mx-auto text-center mb-12 reveal">
      <span class="kicker">Estamos en Punta Arenas, atendemos todo Chile</span>
      <h2 class="font-display font-extrabold uppercase text-[clamp(1.45rem,3.1vw,2.25rem)] leading-snug mt-4 mb-3">Contacto</h2>
      <p class="text-mut dark:text-mutd text-[1rem]">Normalmente respondemos en 2 a 3 horas; máximo 24 horas hábiles.</p>
    </div>
    <div class="grid lg:grid-cols-2 gap-11 max-w-[1020px] mx-auto items-stretch">
      <div class="reveal lg:sticky lg:top-[118px] self-stretch">
        <div class="lg:h-full flex flex-col">
        <h3 class="font-display font-extrabold uppercase text-base mb-3.5">Canales directos</h3>
        <ul class="flex flex-col gap-4 mb-6">
          <li class="group border border-line dark:border-lined rounded-xl bg-pagesoft dark:bg-paged p-4 flex items-center gap-4 transition-colors hover:border-cydeep dark:hover:border-cy hover:bg-cy/5">
            <span class="w-10 h-10 rounded-full bg-cy/10 flex items-center justify-center shrink-0">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" class="w-5 h-5 stroke-cydeep dark:stroke-cyt" aria-hidden="true"><rect x="2" y="6" width="13" height="12" rx="2"/><path d="M15 10.5l7-3.5v10l-7-3.5z"/></svg>
            </span>
            <a class="flex-1 text-[.95rem] font-bold hover:text-cydeep dark:hover:text-cyt" href="https://calendar.app.google/W9CqbvXdKMzcAWHN8" target="_blank" rel="noopener noreferrer">Agendar videollamada de 15 minutos</a>
            <svg viewBox="0 0 24 24" fill="none" class="w-4 h-4 stroke-current text-mut dark:text-mutd group-hover:translate-x-1 group-hover:text-cydeep dark:group-hover:text-cyt transition-transform" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-width="2"/></svg>
          </li>
          <li class="group border border-line dark:border-lined rounded-xl bg-pagesoft dark:bg-paged p-4 flex items-center gap-4 transition-colors hover:border-cydeep dark:hover:border-cy hover:bg-cy/5">
            <span class="w-10 h-10 rounded-full bg-wa/10 flex items-center justify-center shrink-0">
              <svg viewBox="0 0 24 24" class="w-5 h-5 fill-wa" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5.1-1.3A10 10 0 1012 2z"/></svg>
            </span>
            <a class="flex-1 text-[.95rem] font-bold hover:text-wa" href="https://wa.me/56954132014" target="_blank" rel="noopener noreferrer">WhatsApp +56 9 5413 2014</a>
            <svg viewBox="0 0 24 24" fill="none" class="w-4 h-4 stroke-current text-mut dark:text-mutd group-hover:translate-x-1 group-hover:text-wa transition-transform" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-width="2"/></svg>
          </li>
          <li class="group border border-line dark:border-lined rounded-xl bg-pagesoft dark:bg-paged p-4 flex items-center gap-4 transition-colors hover:border-cydeep dark:hover:border-cy hover:bg-cy/5">
            <span class="w-10 h-10 rounded-full bg-cy/10 flex items-center justify-center shrink-0">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" class="w-5 h-5 stroke-cydeep dark:stroke-cyt" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            </span>
            <a class="flex-1 text-[.95rem] font-bold hover:text-cydeep dark:hover:text-cyt" href="mailto:hola@fractalhost.cl">hola@fractalhost.cl</a>
            <svg viewBox="0 0 24 24" fill="none" class="w-4 h-4 stroke-current text-mut dark:text-mutd group-hover:translate-x-1 group-hover:text-cydeep dark:group-hover:text-cyt transition-transform" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-width="2"/></svg>
          </li>
          <li class="group border border-line dark:border-lined rounded-xl bg-pagesoft dark:bg-paged p-4 flex items-center gap-4 transition-colors">
            <span class="w-10 h-10 rounded-full bg-cy/10 flex items-center justify-center shrink-0">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" class="w-5 h-5 stroke-cydeep dark:stroke-cyt" aria-hidden="true"><path d="M12 21s7-5.5 7-11a7 7 0 10-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            </span>
            <span class="flex-1 text-[.95rem] font-semibold">Punta Arenas – Región de Magallanes, Chile</span>
          </li>
          <li class="group border border-line dark:border-lined rounded-xl bg-pagesoft dark:bg-paged p-4 flex items-center gap-4 transition-colors hover:border-cydeep dark:hover:border-cy hover:bg-cy/5">
            <span class="w-10 h-10 rounded-full bg-live/10 flex items-center justify-center shrink-0">
              <span class="w-2.5 h-2.5 rounded-full bg-live animate-pulse" aria-hidden="true"></span>
            </span>
            <a class="flex-1 text-[.95rem] font-bold text-okd dark:text-live hover:text-live" href="https://clientes.fractalhost.cl/serverstatus.php" target="_blank" rel="noopener noreferrer">Estado de servidores en vivo</a>
            <svg viewBox="0 0 24 24" fill="none" class="w-4 h-4 stroke-current text-mut dark:text-mutd group-hover:translate-x-1 group-hover:text-live transition-transform" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-width="2"/></svg>
          </li>
        </ul>
        <p class="text-[.88rem] text-mut dark:text-mutd border-t border-line dark:border-lined pt-5 mt-auto">Soporte y cotización directa: elige el canal que prefieras y te respondemos en nuestro horario de atención.</p>
        </div>
      </div>
      <form id="contactForm" class="bg-white dark:bg-cardd border border-line dark:border-lined rounded-xl p-7 shadow-[0_10px_30px_rgba(0,0,0,.09)] flex flex-col gap-4 reveal d2" novalidate>
        <div>
          <label for="fNombre" class="block text-[.88rem] font-bold mb-1.5">Nombre</label>
          <input id="fNombre" name="nombre" type="text" autocomplete="name" required class="w-full bg-input dark:bg-inputd border border-line dark:border-lined focus:border-cydeep dark:focus:border-cy rounded-md px-4 py-3 text-[1rem] outline-none transition-colors">
          <p class="err hidden mt-1 text-[.8rem] font-bold text-[#B4232A] dark:text-[#FF8A8F]" data-err-for="fNombre"></p>
        </div>
        <div>
          <label for="fEmail" class="block text-[.88rem] font-bold mb-1.5">Correo electrónico</label>
          <input id="fEmail" name="email" type="email" autocomplete="email" required class="w-full bg-input dark:bg-inputd border border-line dark:border-lined focus:border-cydeep dark:focus:border-cy rounded-md px-4 py-3 text-[1rem] outline-none transition-colors">
          <p class="err hidden mt-1 text-[.8rem] font-bold text-[#B4232A] dark:text-[#FF8A8F]" data-err-for="fEmail"></p>
        </div>
        <div>
          <label for="fTelefono" class="block text-[.88rem] font-bold mb-1.5">Teléfono (opcional)</label>
          <input id="fTelefono" name="telefono" type="tel" autocomplete="tel" class="w-full bg-input dark:bg-inputd border border-line dark:border-lined focus:border-cydeep dark:focus:border-cy rounded-md px-4 py-3 text-[1rem] outline-none transition-colors">
        </div>
        <div>
          <label for="fMensaje" class="block text-[.88rem] font-bold mb-1.5">Mensaje</label>
          <textarea id="fMensaje" name="mensaje" required class="w-full min-h-[110px] resize-y bg-input dark:bg-inputd border border-line dark:border-lined focus:border-cydeep dark:focus:border-cy rounded-md px-4 py-3 text-[1rem] outline-none transition-colors"></textarea>
          <p class="err hidden mt-1 text-[.8rem] font-bold text-[#B4232A] dark:text-[#FF8A8F]" data-err-for="fMensaje"></p>
        </div>
        <div>
          <label class="flex items-start gap-3 text-[.85rem] text-mut dark:text-mutd cursor-pointer">
            <input id="fConsent" type="checkbox" class="mt-1 w-4 h-4 accent-[#00A9C4]">
            <span>Acepto que Fractal Host use mi nombre, correo y teléfono solo para responder este mensaje. Más detalles en la Política de Privacidad (pie de página).</span>
          </label>
          <p class="err hidden mt-1 text-[.8rem] font-bold text-[#B4232A] dark:text-[#FF8A8F]" data-err-for="fConsent"></p>
        </div>
        <button type="submit" class="w-full inline-flex justify-center bg-[#3d4450] hover:bg-[#2b313b] text-white font-display font-bold text-[1rem] px-6 py-3.5 rounded-md hover:-translate-y-0.5 transition-all cursor-pointer">Enviar mensaje</button>
        <span id="formNote" class="text-[.84rem] text-okd dark:text-live text-center min-h-[20px]" role="status"></span>
      </form>
    </div>
  </div>
</section>