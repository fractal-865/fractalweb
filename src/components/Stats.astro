---
---

<section id="stats" class="on-dark relative z-10 -mt-10 overflow-hidden text-[#EAF1F8] noise inner-depth" style="background: linear-gradient(180deg, #0C2C3C 0%, #081C2C 55%, #04070D 100%); clip-path: polygon(0 22%, 100% 0, 100% 100%, 0 100%);">
  <div class="max-w-[1180px] mx-auto w-[92%] pt-20 pb-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-y-6 sm:gap-y-10 lg:gap-y-0 reveal lg:divide-x lg:divide-white/10">
      <div class="flex items-center gap-4 lg:pr-6 text-left">
        <div class="w-10 h-10 rounded-lg bg-[#16243F] border border-white/5 flex items-center justify-center shrink-0">
          <svg viewBox="0 0 24 24" fill="none" stroke="#5BC0F8" stroke-width="1.8" class="w-5 h-5 shrink-0" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        </div>
        <div>
          <div class="font-display font-extrabold text-[1.3rem] leading-none"><span data-count="13">13</span></div>
          <div class="text-[.8rem] text-[#B7C4D4] mt-1.5">años de trayectoria</div>
        </div>
      </div>
      <div class="flex items-center gap-4 lg:px-6 text-left">
        <div class="w-10 h-10 rounded-lg bg-[#16243F] border border-white/5 flex items-center justify-center shrink-0">
          <svg viewBox="0 0 24 24" fill="none" stroke="#5BC0F8" stroke-width="1.8" class="w-5 h-5 shrink-0" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        </div>
        <div>
          <div class="font-display font-extrabold text-[1.3rem] leading-none"><span data-count="150">150</span><em class="not-italic text-cyt">+</em></div>
          <div class="text-[.8rem] text-[#B7C4D4] mt-1.5">proyectos entregados</div>
        </div>
      </div>
      <div class="flex items-center gap-4 lg:px-6 text-left">
        <div class="w-10 h-10 rounded-lg bg-[#16243F] border border-white/5 flex items-center justify-center shrink-0">
          <svg viewBox="0 0 24 24" fill="none" stroke="#5BC0F8" stroke-width="1.8" class="w-5 h-5 shrink-0" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        </div>
        <div>
          <div class="font-display font-extrabold text-[1.3rem] leading-none"><span data-count="35">35</span><em class="not-italic text-cyt">+</em></div>
          <div class="text-[.8rem] text-[#B7C4D4] mt-1.5">sitios en nuestros servidores</div>
        </div>
      </div>
      <div class="flex items-center gap-4 lg:px-6 text-left">
        <div class="w-10 h-10 rounded-lg bg-[#16243F] border border-white/5 flex items-center justify-center shrink-0">
          <svg viewBox="0 0 24 24" fill="none" stroke="#5BC0F8" stroke-width="1.8" class="w-5 h-5 shrink-0" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
        </div>
        <div>
          <div class="font-display font-extrabold text-[1.3rem] leading-none"><span data-count="24">24</span>/7</div>
          <div class="text-[.8rem] text-[#B7C4D4] mt-1.5">monitoreo y seguridad</div>
        </div>
      </div>
    </div>
  </div>
</section>
