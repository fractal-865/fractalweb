---
import webpay3c from '../assets/pagos/logo_webpay3C.png';
const logo = typeof webpay3c === 'string' ? webpay3c : webpay3c.src;
const logoW = (webpay3c && webpay3c.width) || 150;
const logoH = (webpay3c && webpay3c.height) || 50;
---

<section id="stats" class="on-dark relative bg-deep noise inner-depth text-[#EAF1F8] overflow-hidden">
  <div class="max-w-[1180px] mx-auto w-[92%] py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-white/10 reveal">
      <div class="text-center px-3 py-6 md:py-0"><div class="font-display font-extrabold text-[clamp(1.4rem,2.7vw,2rem)]"><span data-count="13">13</span></div><div class="text-[.84rem] text-[#B7C4D4] mt-1">años de trayectoria</div></div>
      <div class="text-center px-3 py-6 md:py-0"><div class="font-display font-extrabold text-[clamp(1.4rem,2.7vw,2rem)]"><span data-count="150">150</span><em class="not-italic text-cyt">+</em></div><div class="text-[.84rem] text-[#B7C4D4] mt-1">proyectos entregados</div></div>
      <div class="text-center px-3 py-6 md:py-0"><div class="font-display font-extrabold text-[clamp(1.4rem,2.7vw,2rem)]"><span data-count="35">35</span><em class="not-italic text-cyt">+</em></div><div class="text-[.84rem] text-[#B7C4D4] mt-1">sitios en nuestros servidores</div></div>
      <div class="text-center px-3 py-6 md:py-0"><div class="font-display font-extrabold text-[clamp(1.4rem,2.7vw,2rem)]"><span data-count="24">24</span>/7</div><div class="text-[.84rem] text-[#B7C4D4] mt-1">monitoreo y seguridad</div></div>
    </div>
    <div class="mt-9 flex justify-center">
      <img src={logo} alt="Hasta 3 cuotas sin interés con Webpay" width={logoW} height={logoH} loading="lazy" decoding="async" class="h-10 w-auto rounded-md bg-[#E6F0F7] px-3 py-1.5" />
    </div>
  </div>
</section>
