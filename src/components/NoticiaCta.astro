---
import Icon from './Icon.astro';
import { getCtaForNoticia, type Noticia } from '../lib/noticias';
import { link } from '../lib/url';

interface Props {
  noticia: Noticia;
}

const { noticia } = Astro.props;
const cta = getCtaForNoticia(noticia);
const whatsapp = `https://wa.me/56954132014?text=${encodeURIComponent(
  `Hola, leí la guía "${noticia.title}" y necesito ayuda con ${noticia.category.toLowerCase()}.`
)}`;
---

<section class="article-cta" aria-labelledby="article-cta-title">
  <div class="article-cta__copy">
    <span class="kicker on-dark">Hablemos</span>
    <h2 id="article-cta-title">{cta.title}</h2>
    <p>{cta.text}</p>
  </div>
  <div class="article-cta__actions">
    <a href={link(cta.href)} class="noticia-btn noticia-btn--primary">
      {cta.label} <Icon name="arrow" cls="w-4 h-4" />
    </a>
    <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="noticia-btn noticia-btn--ghost">
      <Icon name="whatsapp" cls="w-4 h-4" /> Hablar por WhatsApp
    </a>
  </div>
</section>
