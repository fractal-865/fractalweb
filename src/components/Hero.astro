---
import { Picture } from 'astro:assets';
import hostingImg from '../assets/hero/hosting.png';
import sitiosWebImg from '../assets/hero/sitios-web.png';
import soporteImg from '../assets/hero/soporte.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imageSizes = '(max-width: 1023px) 88vw, 46vw';
---

<section id="inicio" class="on-dark relative pt-[140px] pb-[90px] text-white bg-deep noise gridlines inner-depth overflow-hidden">
  <div data-px="0.22" class="absolute inset-0 z-0">
    <img
      src={`${base}/fondo-fractal-hosting.avif`}
      srcset={`${base}/fondo-fractal-hosting-960.avif 960w, ${base}/fondo-fractal-hosting-1440.avif 1440w, ${base}/fondo-fractal-hosting.avif 1923w`}
      sizes="110vw"
      alt="Montañas de la Patagonia con líneas de datos y servidores de Fractal Host"
      width="1923"
      height="1253"
      fetchpriority="high"
      decoding="async"
      class="w-full h-full object-cover opacity-70 scale-110"
    />
  </div>
  <div class="absolute inset-0 z-[2] bg-gradient-to-b from-night/90 via-night/55 to-night/95"></div>
  <div class="absolute inset-0 z-[2] bg-[radial-gradient(115%_85%_at_50%_38%,rgba(4,7,13,0)_0%,rgba(4,7,13,.55)_58%,rgba(4,7,13,.92)_100%)]" aria-hidden="true"></div>
  <div data-px="0.1" class="absolute -top-28 -left-28 w-[440px] h-[440px] rounded-full bg-cy/20 blur-[130px] z-[2]" aria-hidden="true"></div>
  <div data-px="-0.07" class="absolute top-1/3 -right-32 w-[400px] h-[400px] rounded-full bg-[#1B74E4]/25 blur-[120px] z-[2]" aria-hidden="true"></div>

  <div id="heroSlider" class="relative z-10 wrap min-h-[500px] flex items-center justify-center">
    <div class="slide is-active" data-slide="0" role="group" aria-roledescription="lámina" aria-label="Servicio de hosting en Punta Arenas">
      <div class="hero-slide">
        <div class="hero-slide__copy">
          <span class="kicker on-dark">Servicio de hosting en Punta Arenas</span>
          <h1 class="font-display font-extrabold uppercase tracking-[.02em] text-[clamp(1.7rem,3.8vw,2.8rem)] leading-tight mt-4 drop-shadow-[0_6px_30px_rgba(0,0,0,.6)]">Hosting en <span class="text-yel drop-shadow-[0_0_22px_rgba(255,230,0,.35)]">Punta Arenas</span> y la Patagonia</h1>
          <p class="mt-4 max-w-[620px] text-[#DCE6F0] text-[1.08rem]">Te damos el espacio en servidor que necesitas para publicar tu <strong>página web</strong> y tener tus <strong>correos electrónicos corporativos</strong> (como contacto@tuempresa.cl), respaldado con infraestructura en el Cono Sur para máxima velocidad.</p>
          <div class="mt-4">
            <p class="hero-offer__note"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" class="w-5 h-5 stroke-cyt shrink-0" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3.5h2.6l2.3 11.2a1.7 1.7 0 001.7 1.4h8.4a1.7 1.7 0 001.7-1.3l1.4-6.3H6"/></svg>Pagas en línea y empiezas hoy.</p>
          </div>
        </div>

        <div class="hero-slide__media">
          <div class="hero-slide__figure">
            <Picture
              src={hostingImg}
              alt="Rack de servidores con nube, sobre de correo y una ventana de sitio web: hosting y correo corporativo de Fractal Host"
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[420, 640, 900, 1312]}
              sizes={imageSizes}
              quality={88}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            />
          </div>

          <div class="hero-slide__offer">
            <p class="hero-offer__price">Hosting desde $39.990<span>/año</span></p>
            <a href="#hosting-global" class="hero-offer__cta">Ver planes de hosting</a>
          </div>
        </div>
      </div>
    </div>

    <div class="slide" data-slide="1" role="group" aria-roledescription="lámina" aria-label="Creación de sitios web en Punta Arenas">
      <div class="hero-slide">
        <div class="hero-slide__copy">
          <span class="kicker on-dark">Creación de sitios web en Punta Arenas</span>
          <p class="font-display font-extrabold uppercase tracking-[.02em] text-[clamp(1.7rem,3.8vw,2.8rem)] leading-tight mt-4 drop-shadow-[0_6px_30px_rgba(0,0,0,.6)]">Tu sitio web listo desde <span class="text-yel drop-shadow-[0_0_22px_rgba(255,230,0,.35)]">24 horas</span></p>
          <p class="mt-4 mb-8 max-w-[620px] text-[#DCE6F0] text-[1.08rem]">Micrositio en 24 h · One Page 3 a 7 días · Sitio de empresa 1 a 3 semanas · Tienda en línea 15 a 45 días. Con dominio .cl y primer año de hosting incluidos.</p>
          <div class="flex flex-wrap gap-3">
            <a href={`${base}/cotizador`} class="inline-flex bg-yel hover:bg-yelhov text-ink font-display font-bold text-[.98rem] px-10 py-3.5 rounded-md shadow-[0_6px_20px_rgba(255,230,0,.28)] hover:-translate-y-1 transition-all">Cotizar mi sitio</a>
            <a href="#sitios-web" class="inline-flex border-2 border-white/40 hover:border-cy hover:text-cyt text-white font-display font-bold text-[.98rem] px-8 py-3.5 rounded-md transition-colors">Ver cómo trabajamos</a>
          </div>
        </div>

        <div class="hero-slide__media">
          <div class="hero-slide__figure">
            <Picture
              src={sitiosWebImg}
              alt="Monitor y teléfono mostrando un sitio web profesional de Fractal Host, con diseño adaptable"
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[480, 720, 960, 1536]}
              sizes={imageSizes}
              quality={88}
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="slide" data-slide="2" role="group" aria-roledescription="lámina" aria-label="Mantención, seguridad y soluciones digitales">
      <div class="hero-slide">
        <div class="hero-slide__copy">
          <span class="kicker on-dark">Mantención, seguridad y soluciones digitales</span>
          <p class="font-display font-extrabold uppercase tracking-[.02em] text-[clamp(1.7rem,3.8vw,2.8rem)] leading-tight mt-4 drop-shadow-[0_6px_30px_rgba(0,0,0,.6)]">Tu <span class="text-yel drop-shadow-[0_0_22px_rgba(255,230,0,.35)]">aliado digital</span> en la Patagonia: más que hosting</p>
          <p class="mt-4 mb-8 max-w-[620px] text-[#DCE6F0] text-[1.08rem]">Te acompañamos con mantención continua, seguridad informática contra ciberataques, adaptación a la Ley 21.719 y soporte directo. Siempre termina atendiéndote una persona.</p>
          <div class="flex flex-wrap gap-3">
            <a href="#mantencion" class="inline-flex bg-yel hover:bg-yelhov text-ink font-display font-bold text-[.98rem] px-10 py-3.5 rounded-md shadow-[0_6px_20px_rgba(255,230,0,.28)] hover:-translate-y-1 transition-all">Ver mantención y seguridad</a>
          </div>
        </div>

        <div class="hero-slide__media">
          <div class="hero-slide__figure">
            <Picture
              src={soporteImg}
              alt="Escudo con marca de verificación, engranaje de herramientas y persona con audífonos: seguridad, mantención y soporte de Fractal Host"
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[480, 720, 960, 1536]}
              sizes={imageSizes}
              quality={88}
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>

    {/* Controles agrupados: en ≥1024px se posicionan en los costados (sin
        pisarse con el texto, que queda libre desde ~948px de viewport) y en
        pantallas menores bajan a una fila inferior junto a los puntos. */}
    <div id="heroControls">
      <button id="slidePrev" aria-label="Lámina anterior" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full border border-white/30 bg-black/20 backdrop-blur-sm hover:border-cy hover:text-cyt flex items-center justify-center transition-colors cursor-pointer"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" class="w-4 h-4 stroke-current" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
      <button id="slideNext" aria-label="Lámina siguiente" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full border border-white/30 bg-black/20 backdrop-blur-sm hover:border-cy hover:text-cyt flex items-center justify-center transition-colors cursor-pointer"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" class="w-4 h-4 stroke-current" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
      <button id="slideToggle" type="button" aria-label="Pausar el carrusel" title="Pausar el carrusel" class="absolute left-4 top-[calc(50%+3.25rem)] z-20 w-10 h-10 rounded-full border border-white/30 bg-black/20 backdrop-blur-sm hover:border-cy hover:text-cyt flex items-center justify-center transition-colors cursor-pointer">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" class="ico-pause w-4 h-4 stroke-current" aria-hidden="true"><path d="M9 5v14M15 5v14"/></svg>
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" class="ico-play w-4 h-4 stroke-current" aria-hidden="true"><path d="M7 4.5l12 7.5-12 7.5z"/></svg>
      </button>
      <div id="heroDots" class="absolute inset-x-0 -bottom-7 flex items-center justify-center gap-1.5">
        {[0, 1, 2].map((i) => (
          <button type="button" class="hero-dot" data-goto={i} aria-current={i === 0 ? 'true' : 'false'} aria-label={`Ir a la lámina ${i + 1} de 3`}></button>
        ))}
      </div>
    </div>
  </div>
  <div id="heroProgress" class="absolute inset-x-0 top-[117px] z-[3] h-[3px] bg-white/20 overflow-hidden" aria-hidden="true"><span id="heroProgressFill" class="block h-full bg-cy transition-all duration-500" style="width:33.34%"></span></div>
</section>

<script>
  // El botón flotante de WhatsApp tapa el texto y la imagen del hero en
  // pantallas bajas. Se oculta mientras el hero está a la vista y reaparece
  // al salir de la sección.
  const hero = document.getElementById('inicio');
  const whatsapp = document.querySelector<HTMLElement>('.wa-ring');
  if (hero && whatsapp && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          whatsapp.classList.toggle('hero-float-oculto', entry.isIntersecting);
        });
      },
      { threshold: 0.08 }
    );
    observer.observe(hero);
  }
</script>
