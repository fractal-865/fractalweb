---
import Icon from './Icon.astro';

interface Props {
  url: string;
  title: string;
  image?: string;
}

const { url, title, image = '' } = Astro.props;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`;
const facebook = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
---

<div class="article-share" data-share data-url={url} data-title={title} data-image={image}>
  <span class="article-share__label">Compartir</span>
  <a
    href={whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    class="article-share__btn"
    aria-label="Compartir por WhatsApp"
  >
    <Icon name="whatsapp" cls="w-4 h-4" />
    <span>WhatsApp</span>
  </a>
  <a
    href={facebook}
    target="_blank"
    rel="noopener noreferrer"
    class="article-share__btn"
    aria-label="Compartir en Facebook"
  >
    <Icon name="facebook" cls="w-4 h-4" />
    <span>Facebook</span>
  </a>
  <button type="button" class="article-share__btn" data-share-instagram aria-label="Compartir en Instagram">
    <Icon name="instagram" cls="w-4 h-4" />
    <span>Instagram</span>
  </button>
  <button type="button" class="article-share__btn" data-share-copy aria-label="Copiar enlace del artículo">
    <Icon name="copy" cls="w-4 h-4" />
    <span>Copiar enlace</span>
  </button>
  <button type="button" class="article-share__btn" data-share-native hidden aria-label="Compartir con otra aplicación">
    <Icon name="share" cls="w-4 h-4" />
    <span>Compartir</span>
  </button>
  <p class="article-share__status" data-share-status role="status" aria-live="polite"></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-share]');
  if (root) {
    const url = root.dataset.url || window.location.href;
    const title = root.dataset.title || document.title;
    const image = root.dataset.image || '';
    const copyButton = root.querySelector<HTMLButtonElement>('[data-share-copy]');
    const instagramButton = root.querySelector<HTMLButtonElement>('[data-share-instagram]');
    const nativeButton = root.querySelector<HTMLButtonElement>('[data-share-native]');
    const status = root.querySelector<HTMLElement>('[data-share-status]');
    let imageFile: File | null = null;

    const announce = (message: string) => {
      if (!status) return;
      status.textContent = message;
      window.setTimeout(() => {
        status.textContent = '';
      }, 3000);
    };

    const copyFallback = () => {
      const area = document.createElement('textarea');
      area.value = url;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      try {
        document.execCommand('copy');
        announce('Enlace copiado');
      } catch {
        announce('No se pudo copiar. Seleccione el enlace manualmente.');
      }
      area.remove();
    };

    const copyLink = async () => {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(url);
          announce('Enlace copiado');
          return;
        } catch {
          // Continúa con el respaldo.
        }
      }
      copyFallback();
    };

    copyButton?.addEventListener('click', async () => {
      await copyLink();
    });

    const prepareImage = async () => {
      if (!image || imageFile) return;
      try {
        const response = await fetch(image);
        if (!response.ok) return;
        const blob = await response.blob();
        imageFile = new File([blob], 'noticia-fractal-host.jpg', {
          type: blob.type || 'image/jpeg',
        });
      } catch {
        // Si la imagen no se puede descargar, se usa el respaldo de enlace.
      }
    };

    if (image) prepareImage();

    instagramButton?.addEventListener('click', async () => {
      if (!imageFile) await prepareImage();

      if (
        imageFile &&
        typeof navigator.share === 'function' &&
        typeof navigator.canShare === 'function' &&
        navigator.canShare({ files: [imageFile] })
      ) {
        try {
          await navigator.share({ files: [imageFile], title, text: title, url });
          announce('Imagen lista para compartir.');
        } catch {
          // El usuario canceló el menú de compartir.
        }
        return;
      }

      await copyLink();
      window.open('https://www.instagram.com/', '_blank', 'noopener');
      announce('Enlace copiado. Pégalo en tu historia o publicación de Instagram.');
    });

    if (nativeButton && typeof navigator.share === 'function') {
      nativeButton.hidden = false;
      nativeButton.addEventListener('click', async () => {
        try {
          await navigator.share({ title, url });
        } catch {
          // El usuario canceló o el sistema no completó la acción.
        }
      });
    }
  }
</script>
