---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path = '', noindex = false } = Astro.props;
const canonical = path ? `https://fractalhost.cl/${path}` : 'https://fractalhost.cl/';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" title="Sitemap" href={`${base}/sitemap.xml`} />
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}/favicon-96x96.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    {!path && !noindex && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        href={`${base}/fondo-fractal-hosting.avif`}
        imagesrcset={`${base}/fondo-fractal-hosting-960.avif 960w, ${base}/fondo-fractal-hosting-1440.avif 1440w, ${base}/fondo-fractal-hosting.avif 1923w`}
        imagesizes="110vw"
      />
    )}
    <meta name="geo.region" content="CL-MA" />
    <meta name="geo.placename" content="Punta Arenas" />
    <meta name="geo.position" content="-53.1638;-70.9171" />
    <meta name="ICBM" content="-53.1638, -70.9171" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fractal Host" />
    <meta property="og:locale" content="es_CL" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://fractalhost.cl/fondo-fractal-hosting.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Montañas de la Patagonia con líneas de datos y servidores de Fractal Host" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://fractalhost.cl/fondo-fractal-hosting.jpg" />
    <link rel="dns-prefetch" href="https://clientes.fractalhost.cl" />
    <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
    <script is:inline>
      try { if (localStorage.getItem('fh-theme') === 'dark') document.documentElement.classList.add('dark'); } catch (e) {}
    </script>
    <script type="application/ld+json" is:inline>
      {"@context":"https://schema.org","@graph":[
        {"@type":"LocalBusiness","@id":"https://fractalhost.cl/#negocio","name":"Fractal Host","slogan":"Patagonia conectada","url":"https://fractalhost.cl/","logo":"/logo.webp","email":"hola@fractalhost.cl","telephone":"+56954132014","priceRange":"$","currenciesAccepted":"CLP","paymentAccepted":"Flow, tarjetas de crédito y débito, Webpay Plus, transferencia, MACH",
        "address":{"@type":"PostalAddress","addressLocality":"Punta Arenas","addressRegion":"Región de Magallanes y de la Antártica Chilena","addressCountry":"CL"},
        "geo":{"@type":"GeoCoordinates","latitude":-53.1638,"longitude":-70.9171},
        "areaServed":[{"@type":"City","name":"Punta Arenas"},{"@type":"Country","name":"Chile"}]},
        {"@type":"WebSite","@id":"https://fractalhost.cl/#web","url":"https://fractalhost.cl/","name":"Fractal Host — Hosting en Punta Arenas y Sitios Web","inLanguage":"es-CL","publisher":{"@id":"https://fractalhost.cl/#negocio"}}
      ]}
    </script>
  </head>
  <body class="bg-page text-txt dark:bg-paged dark:text-txtd font-body antialiased overflow-x-hidden transition-colors duration-300 text-[1.02rem] leading-relaxed">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:bg-yel focus:text-ink focus:px-4 focus:py-2 focus:rounded-md font-display font-bold">Saltar al contenido</a>
    <p id="liveRegion" class="sr-only" role="status" aria-live="polite"></p>
    <slot />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
