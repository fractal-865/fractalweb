---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import HostingGlobal from '../components/HostingGlobal.astro';
import HostingNacional from '../components/HostingNacional.astro';
import ContrataLinea from '../components/ContrataLinea.astro';
import Infra from '../components/Infra.astro';
import Sitios from '../components/Sitios.astro';
import Mantencion from '../components/Mantencion.astro';
import Correo from '../components/Correo.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import Modales from '../components/Modales.astro';
import Cookies from '../components/Cookies.astro';
---

<Layout
  title="Hosting en Punta Arenas y Sitios Web | Fractal Host"
  description="Servicio de hosting desde Punta Arenas: creación de sitios web, correo corporativo, mantención y seguridad web, migración gratis, soporte directo y pago con Flow."
>
  <Header />
  <main id="contenido">
    <Hero />
    <Stats />
    <HostingGlobal />
    <HostingNacional />
    <ContrataLinea />
    <Infra />
    <Sitios />
    <Mantencion />
    <Correo />
    <Faq />
    <Contacto />
  </main>
  <Footer />

  <a href="https://wa.me/56954132014?text=Hola%20Fractal%20Host" target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp" class="wa-ring fixed left-5 bottom-[max(1.25rem,env(safe-area-inset-bottom))] z-50 w-14 h-14 rounded-full bg-gradient-to-br from-[#25D366] to-[#128C4B] flex items-center justify-center shadow-[0_10px_26px_rgba(37,211,102,.45)] hover:scale-110 transition-transform">
    <svg viewBox="0 0 24 24" class="w-7 h-7 fill-white" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"/></svg>
  </a>

  <Modales />
  <Cookies />
