---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cookies from '../components/Cookies.astro';
import Modales from '../components/Modales.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const H = `${base}/#`;
---

<Layout
  title="Página no encontrada (404) | Fractal Host"
  description="No encontramos la página que buscas. Vuelve al inicio, revisa las preguntas frecuentes o cotiza tu sitio web en 3 minutos."
  noindex
>
  <Header />

  <main id="contenido" class="pt-[170px] pb-24 bg-pagesoft dark:bg-paged transition-colors duration-300">
    <div class="wrap text-center max-w-[820px] mx-auto">
      <span class="kicker">Error 404</span>

      <p class="font-display font-extrabold uppercase tracking-tight leading-none text-[clamp(4rem,16vw,10rem)] mt-4 text-cydeep dark:text-cyt drop-shadow-[0_10px_40px_rgba(0,169,196,.25)]">
        404
      </p>

      <h1 class="font-display font-extrabold uppercase text-[clamp(1.4rem,3.4vw,2.2rem)] leading-snug mt-2 mb-4 text-txt dark:text-txtd">
        Esta página no existe <span class="text-ink bg-yel px-2 py-0.5 rounded">o se movió</span>
      </h1>

      <p class="text-mut dark:text-mutd text-[1.02rem] max-w-[640px] mx-auto">
        Puede que el enlace esté viejo o que hayamos reorganizado el sitio. Lo que sí sigue acá:
        los planes de hosting, el cotizador y todas tus dudas resueltas.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={`${base}/`} class="inline-flex bg-yel hover:bg-yelhov text-ink font-display font-extrabold text-[.95rem] px-8 py-3.5 rounded-md shadow-[0_6px_20px_rgba(255,230,0,.28)] hover:-translate-y-1 transition-all">
          Ir al inicio
        </a>
        <a href={`${base}/cotizador/`} class="inline-flex border-2 border-cydeep dark:border-cy text-cydeep dark:text-cyt hover:bg-cydeep hover:text-white dark:hover:bg-cy dark:hover:text-ink font-display font-extrabold text-[.95rem] px-8 py-3.5 rounded-md transition-colors">
          Cotizar mi sitio
        </a>
        <a href={`${H}faq`} class="inline-flex border-2 border-line dark:border-lined text-txt dark:text-txtd hover:border-cydeep dark:hover:border-cy hover:text-cydeep dark:hover:text-cyt font-display font-extrabold text-[.95rem] px-8 py-3.5 rounded-md transition-colors">
          Preguntas frecuentes
        </a>
      </div>

      <!-- ENLACES RÁPIDOS -->
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-3 text-left">
        <a href={`${H}hosting-global`} class="group bg-white dark:bg-cardd border border-line dark:border-lined rounded-xl p-4 hover:border-cydeep dark:hover:border-cy transition-colors">
          <span class="font-display font-extrabold text-[.82rem] uppercase tracking-wider text-cydeep dark:text-cyt block mb-1">Hosting Global</span>
          <span class="text-[.86rem] text-mut dark:text-mutd">Planes cPanel con datacenter en EE. UU. →</span>
        </a>
        <a href={`${H}hosting-nacional`} class="group bg-white dark:bg-cardd border border-line dark:border-lined rounded-xl p-4 hover:border-cydeep dark:hover:border-cy transition-colors">
          <span class="font-display font-extrabold text-[.82rem] uppercase tracking-wider text-cydeep dark:text-cyt block mb-1">Hosting Cono Sur</span>
          <span class="text-[.86rem] text-mut dark:text-mutd">~60 ms de ping para Chile →</span>
        </a>
        <a href={`${H}mantencion`} class="group bg-white dark:bg-cardd border border-line dark:border-lined rounded-xl p-4 hover:border-cydeep dark:hover:border-cy transition-colors">
          <span class="font-display font-extrabold text-[.82rem] uppercase tracking-wider text-cydeep dark:text-cyt block mb-1">Mantención web</span>
          <span class="text-[.86rem] text-mut dark:text-mutd">Actualizaciones, respaldos y seguridad →</span>
        </a>
        <a href={`${H}contacto`} class="group bg-white dark:bg-cardd border border-line dark:border-lined rounded-xl p-4 hover:border-cydeep dark:hover:border-cy transition-colors">
          <span class="font-display font-extrabold text-[.82rem] uppercase tracking-wider text-cydeep dark:text-cyt block mb-1">Contacto</span>
          <span class="text-[.86rem] text-mut dark:text-mutd">WhatsApp, correo y videollamada →</span>
        </a>
      </div>

      <p class="mt-10 text-[.86rem] text-mut dark:text-mutd">
        ¿Prefieres que lo revisemos nosotros? Escríbenos por
        <a href="https://wa.me/56954132014?text=Hola%20Fractal%20Host,%20ingres%C3%A9%20a%20una%20p%C3%A1gina%20que%20no%20existe" target="_blank" rel="noopener noreferrer" class="text-cydeep dark:text-cyt font-semibold underline underline-offset-4 hover:no-underline">WhatsApp</a>
        y te ayudamos a encontrarlo.
      </p>
    </div>
  </main>

  <Footer />
  <Modales />
  <Cookies />
</Layout>
