---
import NoticiaLayout from '../../layouts/NoticiaLayout.astro';
import NoticiaCover from '../../components/NoticiaCover.astro';
import NoticiaInterna from '../../components/NoticiaInterna.astro';
import NoticiaToc from '../../components/NoticiaToc.astro';
import NoticiaFaq from '../../components/NoticiaFaq.astro';
import NoticiaShare from '../../components/NoticiaShare.astro';
import NoticiaCta from '../../components/NoticiaCta.astro';
import NoticiasRelacionadas from '../../components/NoticiasRelacionadas.astro';
import { noticiasVisibles, formatFecha, dateTimeAttribute, type Noticia } from '../../lib/noticias';
import { renderNoticia } from '../../lib/noticias-markdown';
import { link } from '../../lib/url';
import { NOTICIAS_MODO_PREVIA, SITE_URL } from '../../config';

export function getStaticPaths() {
  return noticiasVisibles.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const { noticia } = Astro.props as { noticia: Noticia };
const rendered = renderNoticia(noticia);
const noindex = NOTICIAS_MODO_PREVIA || !noticia.isPublished;
const publishedTime = noticia.datePublished
  ? noticia.datePublished.length === 10
    ? `${noticia.datePublished}T12:00:00-03:00`
    : noticia.datePublished
  : undefined;
const modifiedTime = noticia.dateModified
  ? noticia.dateModified.length === 10
    ? `${noticia.dateModified}T12:00:00-03:00`
    : noticia.dateModified
  : undefined;

const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${noticia.canonical}#article`,
    headline: noticia.title,
    description: noticia.metaDescription,
    inLanguage: 'es-CL',
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': noticia.canonical,
    },
    url: noticia.canonical,
    image: [
      {
        '@type': 'ImageObject',
        url: noticia.cover.ogUrl,
        width: 1200,
        height: 675,
      },
      {
        '@type': 'ImageObject',
        url: noticia.internalImage.ogUrl,
        width: 1200,
        height: 675,
        caption: noticia.internalImage.caption,
      },
    ],
    author: {
      '@type': 'Organization',
      name: noticia.author.name,
      url: noticia.author.url,
    },
    publisher: {
      '@id': `${SITE_URL}/#negocio`,
    },
    articleSection: noticia.category,
    ...(publishedTime ? { datePublished: publishedTime } : {}),
    ...(modifiedTime ? { dateModified: modifiedTime } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${noticia.canonical}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Noticias', item: `${SITE_URL}/noticias/` },
      { '@type': 'ListItem', position: 3, name: noticia.title, item: noticia.canonical },
    ],
  },
];
---

<NoticiaLayout
  title={noticia.seoTitle}
  description={noticia.metaDescription}
  canonical={noticia.path}
  schema={schema}
  image={noticia.cover.ogUrl}
  imageAlt={noticia.cover.alt}
  imageWidth={1200}
  imageHeight={675}
  imageType="image/jpeg"
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  section={noticia.category}
  noindex={noindex}
>
  <article class="noticia-articulo">
    <div class="wrap">
      <nav class="noticias-breadcrumb" aria-label="Miga de pan">
        <a href={link('/')}>Inicio</a>
        <span aria-hidden="true">/</span>
        <a href={link('/noticias/')}>Noticias</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{noticia.title}</span>
      </nav>

      <header class="noticia-header">
        <div class="noticia-header__top">
          <span class="noticia-categoria">{noticia.category}</span>
          {!noticia.isPublished && <span class="noticia-draft-pill">Borrador editorial</span>}
        </div>

        <h1>{noticia.title}</h1>

        <div class="noticia-meta">
          <span>Por Fractal Host</span>
          <span aria-hidden="true">·</span>
          {noticia.isPublished && noticia.datePublished ? (
            <time datetime={dateTimeAttribute(noticia.datePublished)}>{formatFecha(noticia.datePublished)}</time>
          ) : (
            <span>Fecha por asignar</span>
          )}
          <span aria-hidden="true">·</span>
          <span>{noticia.readingTime} min de lectura</span>
        </div>

        <NoticiaShare url={noticia.canonical} title={noticia.title} />
      </header>

      <figure class="noticia-cover">
        <NoticiaCover
          slug={noticia.slug}
          alt={noticia.cover.alt}
          sizes="(max-width: 768px) 100vw, 980px"
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="noticia-reading">
        <NoticiaToc items={rendered.toc} />

        <div class="article-lead" set:html={rendered.introHtml} />

        <NoticiaInterna
          slug={noticia.slug}
          alt={noticia.internalImage.alt}
          caption={noticia.internalImage.caption}
        />

        <div class="article-body" set:html={rendered.bodyHtml} />

        <NoticiaFaq faqs={noticia.faq} />

        <NoticiasRelacionadas noticia={noticia} />

        <NoticiaCta noticia={noticia} />

        <a href={link('/noticias/')} class="article-back">
          ← Volver a Noticias
        </a>
      </div>
    </div>
  </article>
</NoticiaLayout>
