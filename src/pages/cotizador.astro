---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cookies from '../components/Cookies.astro';
import Modales from '../components/Modales.astro';
import '../styles/cotizador.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Cotizador de sitios web | Fractal Host"
  description="Cotiza tu sitio web en 1 minuto: deja tus datos y cuéntanos qué necesitas. También puedes usar el formulario avanzado paso a paso. Respuesta en menos de 24 h hábiles."
  path="cotizador/"
>
  <Header />

  <main id="contenido" class="pt-[152px] pb-20 bg-pagesoft dark:bg-paged transition-colors duration-300">
    <div class="wrap max-lg:flex max-lg:flex-col">
      <!-- ============ ENCABEZADO ============ -->
      <div class="text-center max-w-[860px] mx-auto mb-8 max-lg:order-1">
        <span class="kicker">Cotizador de sitios web</span>
        <h1 class="cot-h1 font-display font-extrabold uppercase text-[clamp(1.6rem,3.6vw,2.5rem)] leading-snug mt-4 mb-3">
          Cotiza tu sitio web <span>sin vueltas</span>
        </h1>
        <p class="text-mut dark:text-mutd text-[1rem]">
          Déjanos lo esencial y te respondemos en menos de 24 h hábiles.
        </p>
      </div>

      <!-- ============ FRANJA DE CONFIANZA ============ -->
      <div class="bg-white dark:bg-cardd border border-line dark:border-lined rounded-xl p-4 md:p-5 mb-6 max-lg:order-3 max-lg:mt-6 shadow-[0_14px_40px_rgba(11,18,32,.06)] dark:shadow-none">
        <div class="flex flex-col lg:flex-row lg:items-center gap-4">
          <div class="flex items-center gap-3 shrink-0">
            <img src={`${base}/web-app-manifest-512x512.png`} alt="Fractal Host" width="56" height="56" class="w-14 h-14 rounded-full border-2 border-cy object-cover" />
            <div class="leading-tight">
              <p class="text-sm font-semibold text-txt dark:text-txtd">Te responde Ariel Díaz</p>
              <p class="text-[11px] text-mut dark:text-mutd">Fundador · Fractal Host</p>
            </div>
          </div>
          <div class="hidden lg:block w-px h-10 bg-line dark:bg-white/10"></div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-mut dark:text-mutd shrink-0">
            <span class="inline-flex items-center gap-1.5"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" class="w-3.5 h-3.5 stroke-cydeep dark:stroke-cyt" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>13 años</span>
            <span class="inline-flex items-center gap-1.5"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" class="w-3.5 h-3.5 stroke-cydeep dark:stroke-cyt" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14"/></svg>+150 proyectos</span>
            <span class="inline-flex items-center gap-1.5"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" class="w-3.5 h-3.5 stroke-cydeep dark:stroke-cyt" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0114 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>Punta Arenas</span>
          </div>
          <div class="hidden lg:block w-px h-10 bg-line dark:bg-white/10"></div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-mut dark:text-mutd">
            <span class="inline-flex items-center gap-1.5"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" class="w-3.5 h-3.5 stroke-ok dark:stroke-live" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Hosting + dominio .cl gratis el 1° año</span>
            <span class="inline-flex items-center gap-1.5"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" class="w-3.5 h-3.5 stroke-ok dark:stroke-live" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Sitio adaptado a móviles</span>
            <span class="inline-flex items-center gap-1.5"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" class="w-3.5 h-3.5 stroke-ok dark:stroke-live" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Mantención de plantillas y plugins</span>
          </div>
        </div>
      </div>

      <!-- ============ COTIZADOR ============ -->
      <div class="bg-white dark:bg-cardd border border-line dark:border-lined rounded-2xl p-5 md:p-8 max-lg:order-2 shadow-[0_20px_60px_rgba(11,18,32,.07)] dark:shadow-none">
        <!-- Pestañas: formulario simple / avanzado -->
        <div class="cot-formtabs" role="tablist" aria-label="Elige el tipo de formulario">
          <button type="button" id="tabSimple" class="cot-formtab is-active" role="tab" aria-selected="true" aria-controls="panelSimple" tabindex="0">
            <span class="cot-formtab__title">Formulario simple <span class="cot-formtab__badge">Recomendado</span></span>
            <span class="cot-formtab__desc">Rápido, en menos de 1 minuto</span>
          </button>
          <button type="button" id="tabAvanzado" class="cot-formtab" role="tab" aria-selected="false" aria-controls="panelAvanzado" tabindex="-1">
            <span class="cot-formtab__title">Formulario avanzado</span>
            <span class="cot-formtab__desc">Paso a paso, con todos los detalles</span>
          </button>
        </div>

        <!-- ============ FORMULARIO SIMPLE ============ -->
        <section id="panelSimple" role="tabpanel" aria-labelledby="tabSimple" tabindex="0" class="cot-simple-panel">
          <div class="text-center mb-6">
            <h2 class="font-display font-bold text-lg md:text-xl text-txt dark:text-txtd">Cuéntanos lo esencial</h2>
            <p class="text-sm text-mut dark:text-mutd mt-1">Sin formularios largos. Te contactamos con una propuesta clara.</p>
            <p class="lg:hidden text-[11px] font-semibold text-cydeep dark:text-cyt mt-2">Te responde Ariel Díaz · Fundador de Fractal Host</p>
          </div>

          <form id="sfForm" novalidate>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="sf-label" for="sfNombre">Nombre <span class="sf-req">*</span></label>
                <input id="sfNombre" name="nombre" type="text" class="cot-input" autocomplete="name" placeholder="Ej: María" required aria-required="true" aria-describedby="sfErrNombre" />
                <p id="sfErrNombre" class="cot-err" hidden>Escribe tu nombre.</p>
              </div>
              <div>
                <label class="sf-label" for="sfFono">Teléfono o WhatsApp <span class="sf-opt">(opcional)</span></label>
                <div class="cot-fono">
                  <span class="cot-prefix">+56</span>
                  <input id="sfFono" name="telefono" type="tel" inputmode="tel" maxlength="16" class="cot-input" placeholder="9 1234 5678" autocomplete="tel-national" aria-describedby="sfFonoHint sfErrFono" />
                </div>
                <p id="sfFonoHint" class="sf-counter">9 dígitos después de +56</p>
                <p id="sfErrFono" class="cot-err" hidden>Escribe los 9 dígitos después de +56.</p>
              </div>
              <div class="sm:col-span-2">
                <label class="sf-label" for="sfMail">Correo electrónico <span class="sf-req">*</span></label>
                <input id="sfMail" name="correo" type="email" class="cot-input" autocomplete="email" placeholder="tucorreo@empresa.cl" required aria-required="true" aria-describedby="sfErrMail" />
                <p id="sfErrMail" class="cot-err" hidden>Escribe un correo válido.</p>
              </div>
            </div>

            <fieldset class="mt-6">
              <legend class="sf-label">¿Qué necesitas? <span class="sf-req">*</span></legend>
              <div class="sf-goals">
                <label class="sf-goal">
                  <input class="sr-only" type="radio" name="sfGoal" value="Sitio web nuevo" required />
                  <span class="sf-goal__inner">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M9 9h6M12 6v6"/></svg>
                    <span class="sf-goal__name">Sitio nuevo</span>
                    <span class="sf-goal__desc">Desde cero</span>
                  </span>
                </label>
                <label class="sf-goal">
                  <input class="sr-only" type="radio" name="sfGoal" value="Rediseño de sitio web" required />
                  <span class="sf-goal__inner">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M20 11a8 8 0 10-2.5 5.8"/><path d="M20 4v7h-7"/></svg>
                    <span class="sf-goal__name">Rediseño</span>
                    <span class="sf-goal__desc">Renovar mi sitio</span>
                  </span>
                </label>
                <label class="sf-goal">
                  <input class="sr-only" type="radio" name="sfGoal" value="Mantención web" required />
                  <span class="sf-goal__inner">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M14.7 6.3a4.5 4.5 0 00-6 5.6L3 17.6V21h3.4l5.7-5.7a4.5 4.5 0 005.6-6l-3 3-2.3-2.3 3-3z"/></svg>
                    <span class="sf-goal__name">Mantención</span>
                    <span class="sf-goal__desc">Cuidar mi sitio</span>
                  </span>
                </label>
              </div>
              <p id="sfErrGoal" class="cot-err" hidden>Elige una opción.</p>
            </fieldset>

            <div id="sfTipoWrap" class="mt-6" hidden>
              <fieldset aria-describedby="sfErrTipo">
                <legend class="sf-label">¿Qué tipo de sitio necesitas? <span class="sf-req">*</span></legend>
                <p class="sf-help sf-help--tight">Elige la opción que más se parezca. Si no estás seguro, marca la última.</p>
                <div class="sf-types">
                  <label class="sf-type">
                    <input class="sr-only" type="radio" name="sfTipoSitio" value="One Page o micrositio" />
                    <span class="sf-type__inner">
                      <span class="sf-type__name">One Page o micrositio</span>
                      <span class="sf-type__desc">Tarjeta digital o Linktree</span>
                    </span>
                  </label>
                  <label class="sf-type">
                    <input class="sr-only" type="radio" name="sfTipoSitio" value="Sitio informativo o corporativo" />
                    <span class="sf-type__inner">
                      <span class="sf-type__name">Sitio informativo o corporativo</span>
                      <span class="sf-type__desc">Presenta tu empresa y servicios</span>
                    </span>
                  </label>
                  <label class="sf-type">
                    <input class="sr-only" type="radio" name="sfTipoSitio" value="Turismo, reservas y horas" />
                    <span class="sf-type__inner">
                      <span class="sf-type__name">Turismo, reservas y horas</span>
                      <span class="sf-type__desc">Tours, cupos y agenda</span>
                    </span>
                  </label>
                  <label class="sf-type">
                    <input class="sr-only" type="radio" name="sfTipoSitio" value="Clínica o dentista" />
                    <span class="sf-type__inner">
                      <span class="sf-type__name">Clínica o dentista</span>
                      <span class="sf-type__desc">Horas, tratamientos y especialidades</span>
                    </span>
                  </label>
                  <label class="sf-type">
                    <input class="sr-only" type="radio" name="sfTipoSitio" value="Inmobiliaria" />
                    <span class="sf-type__inner">
                      <span class="sf-type__name">Inmobiliaria</span>
                      <span class="sf-type__desc">Propiedades, fichas y contacto</span>
                    </span>
                  </label>
                  <label class="sf-type">
                    <input class="sr-only" type="radio" name="sfTipoSitio" value="Tienda online" />
                    <span class="sf-type__inner">
                      <span class="sf-type__name">Tienda online</span>
                      <span class="sf-type__desc">Catálogo, carrito y pagos</span>
                    </span>
                  </label>
                  <label class="sf-type">
                    <input class="sr-only" type="radio" name="sfTipoSitio" value="A medida" />
                    <span class="sf-type__inner">
                      <span class="sf-type__name">A medida</span>
                      <span class="sf-type__desc">Proyecto especial</span>
                    </span>
                  </label>
                  <label class="sf-type">
                    <input class="sr-only" type="radio" name="sfTipoSitio" value="No estoy seguro" />
                    <span class="sf-type__inner">
                      <span class="sf-type__name">No estoy seguro</span>
                      <span class="sf-type__desc">Te ayudamos a elegir</span>
                    </span>
                  </label>
                </div>
              </fieldset>
              <p id="sfErrTipo" class="cot-err" hidden>Elige el tipo de sitio o “No estoy seguro”.</p>
            </div>

            <div id="sfSiteUrlWrap" class="mt-4" hidden>
              <label class="sf-sublabel" for="sfSiteUrl">Dirección de tu sitio actual <span class="sf-req">*</span></label>
              <div class="sf-input-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.4 2.5 3.7 5.6 3.7 9s-1.3 6.5-3.7 9c-2.4-2.5-3.7-5.6-3.7-9S9.6 5.5 12 3z"/></svg>
                <input id="sfSiteUrl" name="sitio_actual" type="text" inputmode="url" class="cot-input" placeholder="https://tusitio.cl" autocomplete="url" value="https://" aria-describedby="sfErrSiteUrl" />
              </div>
              <p class="sf-help">Escribe el dominio o la dirección completa.</p>
              <p id="sfErrSiteUrl" class="cot-err" hidden>Escribe la dirección de tu sitio actual.</p>
            </div>

            <div class="mt-6">
              <label class="sf-label" for="sfMensaje">Cuéntanos brevemente qué necesitas <span class="sf-opt">(opcional)</span></label>
              <textarea id="sfMensaje" name="mensaje" rows="3" class="cot-input" placeholder="Ej: tengo una pyme y quiero empezar a vender en línea."></textarea>
            </div>

            <label class="sr-only" aria-hidden="true">No completar este campo: <input type="text" id="sfWebsite" name="fh_website" tabindex="-1" autocomplete="off" /></label>

            <div class="sf-consent mt-5">
              <input id="sfPrivacidad" name="privacidad" type="checkbox" required aria-required="true" aria-describedby="sfErrPrivacidad" />
              <div class="sf-consent__text">
                <label for="sfPrivacidad">Acepto el tratamiento de mis datos para responder esta solicitud de cotización.</label>
                <button type="button" data-modal="modal-privacidad" class="sf-consent__link">Ver política de privacidad</button>
              </div>
            </div>
            <p id="sfErrPrivacidad" class="cot-err" hidden>Debes aceptar la política de privacidad para enviar tu solicitud.</p>

            <div id="sfActions" class="sf-actions mt-6">
              <button type="submit" id="sfSubmit" class="cot-btn cot-btn-lg sf-submit">
                <span class="sf-submit__long">Quiero mi cotización</span>
                <span class="sf-submit__short">Cotizar</span>
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
              <button type="button" id="sfWhatsAppSubmit" class="sf-wa-submit" tabindex="-1" aria-hidden="true" aria-label="Enviar la cotización por WhatsApp">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm5.2 14.2c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.5-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1.1-1.4-1.1-2.7s.7-1.9.9-2.2c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4s.8 1.9.8 2c.1.1.1.3 0 .5-.3.6-.7.9-.5 1.2.7 1.2 1.6 2 2.8 2.6.3.2.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.2.5.3.6.4.1.2.1.8-.1 1.3z"/></svg>
                <span>WhatsApp</span>
              </button>
            </div>
            <p class="text-center text-[11px] text-mut dark:text-mutd mt-3">Sin compromiso · Respuesta en menos de 24 h hábiles · Usamos tus datos solo para responderte.</p>
            <p id="sfEstado" class="sr-only" role="status" aria-live="polite"></p>
          </form>

          <div id="sfSuccess" class="sf-success" hidden role="status" aria-live="polite">
            <div class="sf-success__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </div>
            <h3 id="sfSuccessTitle" tabindex="-1" class="font-display font-bold text-xl text-txt dark:text-txtd">¡Recibido!</h3>
            <p id="sfSuccessText" class="text-sm text-mut dark:text-mutd mt-2 max-w-md mx-auto"></p>
            <p class="text-xs text-mut dark:text-mutd mt-3">Código de seguimiento: <b id="sfCode" class="text-txt dark:text-txtd">—</b></p>
            <a id="sfWhatsapp" href="https://wa.me/56954132014" target="_blank" rel="noopener noreferrer" class="sf-wa">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm5.2 14.2c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.5-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1.1-1.4-1.1-2.7s.7-1.9.9-2.2c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4s.8 1.9.8 2c.1.1.1.3 0 .5-.3.6-.7.9-.5 1.2.7 1.2 1.6 2 2.8 2.6.3.2.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.2.5.3.6.4.1.2.1.8-.1 1.3z"/></svg>
              <span id="sfWhatsappLabel">Enviar por WhatsApp</span>
            </a>
            <button type="button" id="sfAgain" class="cot-btn-2 mt-3">Enviar otra solicitud</button>
          </div>

          <noscript>
            <p class="cot-soft rounded-xl p-4 mt-5 text-sm text-center">Este formulario necesita JavaScript. Escríbenos a <a class="font-bold underline" href="mailto:hola@fractalhost.cl">hola@fractalhost.cl</a> o por <a class="font-bold underline" href="https://wa.me/56954132014" target="_blank" rel="noopener noreferrer">WhatsApp</a>.</p>
          </noscript>
        </section>

        <!-- ============ FORMULARIO AVANZADO ============ -->
        <section id="panelAvanzado" role="tabpanel" aria-labelledby="tabAvanzado" tabindex="0" hidden>
        <!-- Progreso / Breadcrumb -->
        <div class="mb-8">
          <div class="flex justify-between mb-3 gap-1 flex-wrap">
            <button type="button" id="lbl1" onclick="irAPaso(1)" class="cot-lbl done">1 · Lo que necesitas</button>
            <button type="button" id="lbl2" onclick="irAPaso(2)" class="cot-lbl">2 · Tu negocio</button>
            <button type="button" id="lbl3" onclick="irAPaso(3)" class="cot-lbl">3 · Tus datos</button>
            <button type="button" id="lbl4" onclick="irAPaso(4)" class="cot-lbl">4 · Opciones adicionales</button>
            <button type="button" id="lbl5" onclick="irAPaso(5)" class="cot-lbl">5 · Resumen</button>
          </div>
          <div class="cot-track">
            <div id="progressBar" class="cot-fill" style="width:20%"></div>
          </div>
          <p class="text-[10px] text-mut dark:text-mutd mt-1.5">Puedes volver a cualquier paso ya completado. Para avanzar te pediremos solo lo obligatorio. Tu avance se guarda solo en este navegador.</p>
        </div>

        <!-- Título de sección SIEMPRE visible -->
        <div class="mb-6">
          <h2 class="font-display font-bold text-lg mb-1 text-txt dark:text-txtd">¿Qué necesitas?</h2>
          <p class="text-sm text-mut dark:text-mutd">Elige el servicio y afina los detalles con botones, sin escribir de más.</p>
        </div>

        <!-- ============ PASO 1 ============ -->
        <div id="paso1" class="cot-step active">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-6">
            <button type="button" class="tab-modo cot-card cot-tab relative p-4 text-left" data-modo="nuevo">
              <span class="cot-check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#111318" stroke-width="3.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <div class="flex items-center gap-3">
                <span class="cot-ico shrink-0"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg></span>
                <span>
                  <span class="block font-display font-semibold text-sm md:text-[15px] text-txt dark:text-txtd">Crear sitio web nuevo</span>
                  <span class="block text-[11px] text-mut dark:text-mutd">Hacemos tu sitio desde cero</span>
                </span>
              </div>
            </button>
            <button type="button" class="tab-modo cot-card cot-tab relative p-4 text-left" data-modo="rediseno">
              <span class="cot-check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#111318" stroke-width="3.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <div class="flex items-center gap-3">
                <span class="cot-ico shrink-0"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M20 11a8 8 0 10-2.5 5.8"/><path d="M20 4v7h-7"/></svg></span>
                <span>
                  <span class="block font-display font-semibold text-sm md:text-[15px] text-txt dark:text-txtd">Rediseñar mi sitio</span>
                  <span class="block text-[11px] text-mut dark:text-mutd">Renovar un sitio existente</span>
                </span>
              </div>
            </button>
            <button type="button" class="tab-modo cot-card cot-tab relative p-4 text-left" data-modo="mantencion">
              <span class="cot-check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#111318" stroke-width="3.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <div class="flex items-center gap-3">
