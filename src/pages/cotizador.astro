---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cookies from '../components/Cookies.astro';
import Modales from '../components/Modales.astro';
import '../styles/cotizador.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Cotizador de sitios web | Fractal Host"
  description="Cotiza tu sitio web paso a paso: elige el tipo de sitio, hosting, dominio y opciones adicionales. Recibe la cotización formal en menos de 24 h hábiles."
  path="cotizador/"
>
  <Header />

  <main id="contenido" class="pt-[152px] pb-20 bg-pagesoft dark:bg-paged transition-colors duration-300">
    <div class="wrap">
      <!-- ============ ENCABEZADO ============ -->
      <div class="text-center max-w-[860px] mx-auto mb-8">
        <span class="kicker">Cotizador de sitios web</span>
        <h1 class="cot-h1 font-display font-extrabold uppercase text-[clamp(1.6rem,3.6vw,2.5rem)] leading-snug mt-4 mb-3">
          Cotiza tu sitio web <span>paso a paso</span>
        </h1>
        <p class="text-mut dark:text-mutd text-[1rem]">
          Sin tecnicismos y sin perderte: eliges con botones, revisas el resumen y lo envías.
          Nosotros te respondemos con la cotización formal.
        </p>
      </div>

      <!-- ============ FRANJA DE CONFIANZA ============ -->
      <div class="bg-white dark:bg-cardd border border-line dark:border-lined rounded-xl p-4 md:p-5 mb-6 shadow-[0_14px_40px_rgba(11,18,32,.06)] dark:shadow-none">
        <div class="flex flex-col lg:flex-row lg:items-center gap-4">
          <div class="flex items-center gap-3 shrink-0">
            <img src={`${base}/logo.webp`} alt="Fractal Host" width="56" height="56" class="w-14 h-14 rounded-full border-2 border-cy object-cover" />
            <div class="leading-tight">
              <p class="text-sm font-semibold text-txt dark:text-txtd">Te responde Ariel Díaz</p>
              <p class="text-[11px] text-mut dark:text-mutd">Fundador · Fractal Host</p>
            </div>
          </div>
          <div class="hidden lg:block w-px h-10 bg-line dark:bg-white/10"></div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-mut dark:text-mutd shrink-0">
            <span class="inline-flex items-center gap-1.5"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" class="w-3.5 h-3.5 stroke-cydeep dark:stroke-cyt" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>13 años</span>
            <span class="inline-flex items-center gap-1.5"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" class="w-3.5 h-3.5 stroke-cydeep dark:stroke-cyt" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14"/></svg>+150 proyectos</span>
            <span class="inline-flex items-center gap-1.5"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" class="w-3.5 h-3.5 stroke-cydeep dark:stroke-cyt" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0114 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>Punta Arenas</span>
          </div>
          <div class="hidden lg:block w-px h-10 bg-line dark:bg-white/10"></div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-mut dark:text-mutd">
            <span class="inline-flex items-center gap-1.5"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" class="w-3.5 h-3.5 stroke-ok dark:stroke-live" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Hosting + dominio .cl gratis el 1° año</span>
            <span class="inline-flex items-center gap-1.5"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" class="w-3.5 h-3.5 stroke-ok dark:stroke-live" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Sitio adaptado a móviles</span>
            <span class="inline-flex items-center gap-1.5"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" class="w-3.5 h-3.5 stroke-ok dark:stroke-live" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Mantención de plantillas y plugins</span>
          </div>
        </div>
      </div>

      <!-- ============ COTIZADOR ============ -->
      <div class="bg-white dark:bg-cardd border border-line dark:border-lined rounded-2xl p-5 md:p-8 shadow-[0_20px_60px_rgba(11,18,32,.07)] dark:shadow-none">
        <!-- Progreso / Breadcrumb -->
        <div class="mb-8">
          <div class="flex justify-between mb-3 gap-1 flex-wrap">
            <button type="button" id="lbl1" onclick="irAPaso(1)" class="cot-lbl done">1 · Lo que necesitas</button>
            <button type="button" id="lbl2" onclick="irAPaso(2)" class="cot-lbl">2 · Tu negocio</button>
            <button type="button" id="lbl3" onclick="irAPaso(3)" class="cot-lbl">3 · Tus datos</button>
            <button type="button" id="lbl4" onclick="irAPaso(4)" class="cot-lbl">4 · Opciones adicionales</button>
            <button type="button" id="lbl5" onclick="irAPaso(5)" class="cot-lbl">5 · Resumen</button>
          </div>
          <div class="cot-track">
            <div id="progressBar" class="cot-fill" style="width:20%"></div>
          </div>
          <p class="text-[10px] text-mut dark:text-mutd mt-1.5">Puedes volver a cualquier paso ya completado. Para avanzar te pediremos solo lo obligatorio. Tu avance se guarda solo en este navegador.</p>
        </div>

        <!-- Título de sección SIEMPRE visible -->
        <div class="mb-6">
          <h2 class="font-display font-bold text-lg mb-1 text-txt dark:text-txtd">¿Qué necesitas?</h2>
          <p class="text-sm text-mut dark:text-mutd">Elige el servicio y afina los detalles con botones, sin escribir de más.</p>
        </div>

        <!-- ============ PASO 1 ============ -->
        <div id="paso1" class="cot-step active">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-6">
            <button type="button" class="tab-modo cot-card cot-tab relative p-4 text-left" data-modo="nuevo">
              <span class="cot-check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#111318" stroke-width="3.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <div class="flex items-center gap-3">
                <span class="cot-ico shrink-0"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg></span>
                <span>
                  <span class="block font-display font-semibold text-sm md:text-[15px] text-txt dark:text-txtd">Crear sitio web nuevo</span>
                  <span class="block text-[11px] text-mut dark:text-mutd">Hacemos tu sitio desde cero</span>
                </span>
              </div>
            </button>
            <button type="button" class="tab-modo cot-card cot-tab relative p-4 text-left" data-modo="rediseno">
              <span class="cot-check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#111318" stroke-width="3.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <div class="flex items-center gap-3">
                <span class="cot-ico shrink-0"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M20 11a8 8 0 10-2.5 5.8"/><path d="M20 4v7h-7"/></svg></span>
                <span>
                  <span class="block font-display font-semibold text-sm md:text-[15px] text-txt dark:text-txtd">Rediseñar mi sitio</span>
                  <span class="block text-[11px] text-mut dark:text-mutd">Renovar un sitio existente</span>
                </span>
              </div>
            </button>
            <button type="button" class="tab-modo cot-card cot-tab relative p-4 text-left" data-modo="mantencion">
              <span class="cot-check" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#111318" stroke-width="3.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg></span>
              <div class="flex items-center gap-3">
                <span class="cot-ico shrink-0"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M14.7 6.3a4.5 4.5 0 00-6 5.6L3 17.6V21h3.4l5.7-5.7a4.5 4.5 0 005.6-6l-3 3-2.3-2.3 3-3z"/></svg></span>
                <span>
                  <span class="block font-display font-semibold text-sm md:text-[15px] text-txt dark:text-txtd">Mantención web</span>
                  <span class="block text-[11px] text-mut dark:text-mutd">Nos hacemos cargo de tu sitio</span>
                </span>
              </div>
            </button>
          </div>

          <!-- CREAR SITIO NUEVO -->
          <div id="tabNuevo">
            <div class="grid lg:grid-cols-[minmax(0,1fr)_400px] gap-6 items-start">
              <div>
                <div id="tiposGrid" class="grid sm:grid-cols-2 gap-4 content-start"></div>
                <div id="barraSeleccion" class="mt-6 flex flex-wrap items-center gap-2"></div>
              </div>
              <aside class="lg:sticky lg:top-[140px]">
                <div id="panelDetalle" class="cot-panel"></div>
              </aside>
            </div>
          </div>

          <!-- REDISEÑO -->
          <div id="tabRediseno" class="hidden">
            <div id="panelRediseno" class="cot-panel md:p-6"></div>
          </div>

          <!-- MANTENCIÓN -->
          <div id="tabMantencion" class="hidden">
            <div id="panelMantencion" class="cot-panel md:p-6"></div>
          </div>
        </div>

        <!-- ============ PASO 2 ============ -->
        <div id="paso2" class="cot-step">
          <h2 class="font-display font-bold text-lg mb-6 text-txt dark:text-txtd">Cuéntanos de tu negocio</h2>
          <div class="grid lg:grid-cols-2 gap-x-10 gap-y-7">

            <div>
              <div class="flex items-center gap-2.5 mb-2.5">
                <span class="cot-chip">1</span>
                <span class="cot-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14"/><path d="M9 10h.01M15 10h.01M9 14h.01M15 14h.01M10 21v-3h4v3"/></svg></span>
                <p class="font-medium text-sm md:text-base text-txt dark:text-txtd">Nombre de tu negocio o proyecto *</p>
              </div>
              <input id="inpNegocio" type="text" placeholder="Ej: Cabañas Río Verde" class="cot-input" />
              <p id="errNegocio" class="cot-err hidden">Escribe el nombre de tu negocio o proyecto.</p>
            </div>

            <div>
              <div class="flex items-center gap-2.5 mb-2.5">
                <span class="cot-chip">2</span>
                <span class="cot-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.5 3.1-5.5 7-5.5s7 2 7 5.5"/></svg></span>
                <p class="font-medium text-sm md:text-base text-txt dark:text-txtd">¿Cotizas como persona o como empresa? *</p>
              </div>
              <div id="grupoPersona" class="grid grid-cols-2 gap-3">
                <div class="persona-card cot-card selectable p-4 text-center" data-pers="natural">
                  <div class="cot-ico flex justify-center mb-2"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.5 3.1-5.5 7-5.5s7 2 7 5.5"/></svg></div>
                  <p class="text-sm font-medium text-txt dark:text-txtd">Persona natural</p>
                </div>
                <div class="persona-card cot-card selectable p-4 text-center" data-pers="empresa">
                  <div class="cot-ico flex justify-center mb-2"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14"/><path d="M9 10h.01M15 10h.01M9 14h.01M15 14h.01M10 21v-3h4v3"/></svg></div>
                  <p class="text-sm font-medium text-txt dark:text-txtd">Empresa</p>
                </div>
              </div>
              <p id="errPersona" class="cot-err hidden">Elige si cotizas como persona o empresa.</p>
            </div>

            <div>
              <div class="flex items-center gap-2.5 mb-2.5">
                <span class="cot-chip">3</span>
                <span class="cot-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16v13H4z"/><path d="M4 7l2-3h12l2 3M9 12h6"/></svg></span>
                <p class="font-medium text-sm md:text-base text-txt dark:text-txtd">Rubro de tu negocio *</p>
              </div>
              <select id="inpRubro" class="cot-select">
                <option value="" selected disabled>Selecciona tu rubro…</option>
                <option>Turismo y viajes</option>
                <option>Comercio y retail</option>
                <option>Servicios profesionales</option>
                <option>Salud y bienestar</option>
                <option>Construcción e inmobiliario</option>
                <option>Gastronomía</option>
                <option>Educación</option>
                <option>Transporte y logística</option>
                <option>Agro y ganadería</option>
                <option>Tecnología</option>
                <option>Otro</option>
              </select>
              <div id="cajaRubroOtro" class="hidden mt-3">
                <input id="inpRubroOtro" type="text" placeholder="Cuéntanos tu rubro" class="cot-input" />
              </div>
              <p id="errRubro" class="cot-err hidden">Selecciona tu rubro para continuar.</p>
            </div>

            <div>
              <div class="flex items-center gap-2.5 mb-1">
                <span class="cot-chip">4</span>
                <span class="cot-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
                <p class="font-medium text-sm md:text-base text-txt dark:text-txtd">¿Cuántas cuentas de correo necesitas? *</p>
              </div>
              <p class="text-xs text-mut dark:text-mutd mb-3 ml-9">El correo corporativo va incluido con tu hosting.</p>
              <div class="flex flex-wrap gap-2.5" id="grupoCorreos">
                <button type="button" class="cot-seg" data-val="1 a 3">1 a 3</button>
                <button type="button" class="cot-seg" data-val="4 a 10">4 a 10</button>
                <button type="button" class="cot-seg" data-val="11 a 20">11 a 20</button>
                <button type="button" class="cot-seg" data-val="Más de 20">Más de 20</button>
                <button type="button" class="cot-seg" data-val="No lo sé">No lo sé</button>
              </div>
              <p id="errCorreos" class="cot-err hidden">Cuéntanos cuántas cuentas de correo necesitas (o elige "No lo sé").</p>
            </div>

            <div>
              <div class="flex items-center gap-2.5 mb-1">
                <span class="cot-chip">5</span>
                <span class="cot-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 4 5.6 4 9s-1.5 6.4-4 9c-2.5-2.6-4-5.6-4-9s1.5-6.4 4-9z"/></svg></span>
                <p class="font-medium text-sm md:text-base text-txt dark:text-txtd">¿Ya tienes un dominio registrado? *</p>
              </div>
              <p class="text-xs text-mut dark:text-mutd mb-3 ml-9">El dominio es la dirección de tu sitio, por ejemplo <strong class="text-txt dark:text-txtd">minegocio.cl</strong>.</p>
              <div class="flex flex-wrap gap-2.5" id="grupoDominio">
                <button type="button" class="cot-seg" data-val="si">Sí, ya lo tengo</button>
                <button type="button" class="cot-seg" data-val="no">No, aún no</button>
                <button type="button" class="cot-seg" data-val="nose">No sé</button>
              </div>
              <div id="cajaDominio" class="hidden mt-3">
                <label id="lblDominio" class="text-xs text-mut dark:text-mutd block mb-1.5 font-medium" for="inpDominio">Escríbelo aquí</label>
                <input id="inpDominio" type="text" placeholder="Ej: minegocio.cl" class="cot-input md:!w-80" />
              </div>
              <p id="notaDominioNose" class="hidden text-xs text-ok dark:text-live mt-2">Tranquilo: lo revisamos juntos cuando conversemos.</p>
              <p id="errDominio" class="cot-err hidden">Elige una opción sobre tu dominio.</p>
            </div>

            <!-- SELECTOR DE HOSTING -->
            <div id="cajaHosting" class="lg:col-span-2"></div>

          </div>
          <div class="flex justify-between mt-8">
            <button type="button" onclick="irPaso(1)" class="cot-btn-2">← Volver</button>
            <button type="button" onclick="irPaso(3)" class="cot-btn">Siguiente →</button>
          </div>
        </div>

        <!-- ============ PASO 3 ============ -->
        <div id="paso3" class="cot-step">
          <h2 class="font-display font-bold text-lg mb-6 text-txt dark:text-txtd">Tus datos y preferencias</h2>

          <div class="cot-note-info flex gap-3 items-start mb-6">
            <span class="cot-ico mt-0.5"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
            <p class="text-xs md:text-sm">Cuando partamos, nos envías <strong>logo, fotos y textos</strong> a <a href="mailto:hola@fractalhost.cl" class="font-semibold underline underline-offset-2">hola@fractalhost.cl</a>. No necesitas tenerlos ahora para cotizar.</p>
          </div>

          <div class="grid lg:grid-cols-2 gap-x-10 gap-y-6">
            <div class="space-y-5">
              <div>
                <label class="flex items-center gap-2 text-sm text-mut dark:text-mutd mb-1.5" for="inpNombre">
                  <span class="cot-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.5 3.1-5.5 7-5.5s7 2 7 5.5"/></svg></span>
                  Tu nombre *
                </label>
                <input id="inpNombre" type="text" placeholder="Ej: María González" class="cot-input" />
                <p id="errNombre" class="cot-err hidden">Escribe tu nombre para poder contactarte.</p>
              </div>
              <div>
                <label class="flex items-center gap-2 text-sm text-mut dark:text-mutd mb-1.5" for="inpFono">
                  <span class="cot-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg></span>
                  WhatsApp / celular *
                </label>
                <div class="cot-fono">
                  <span class="cot-prefix">+56 9</span>
                  <input id="inpFono" type="tel" inputmode="numeric" placeholder="1234 5678" class="cot-input" />
                </div>
                <p class="text-[11px] text-mut dark:text-mutd mt-1.5">Solo escribe los 8 dígitos de tu número.</p>
                <p id="errFono" class="cot-err hidden">Completa los 8 dígitos de tu celular.</p>
              </div>
              <div>
                <label class="flex items-center gap-2 text-sm text-mut dark:text-mutd mb-1.5" for="inpMail">
                  <span class="cot-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
                  Correo *
                </label>
                <input id="inpMail" type="email" placeholder="tucorreo@empresa.cl" class="cot-input" />
                <p id="errMail" class="cot-err hidden">Escribe un correo válido para enviarte la cotización.</p>
              </div>
              <div>
                <label class="flex items-center gap-2 text-sm text-mut dark:text-mutd mb-1.5" for="inpRut">
                  <span class="cot-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14"/><path d="M9 10h.01M15 10h.01M9 14h.01M15 14h.01"/></svg></span>
                  RUT de tu empresa <span class="opacity-70">(opcional)</span>
                </label>
                <input id="inpRut" type="text" placeholder="Ej: 76.123.456-7" maxlength="12" class="cot-input" />
              </div>
              <div>
                <p class="flex items-center gap-2 font-medium text-sm md:text-base mb-2.5 text-txt dark:text-txtd">
                  <span class="cot-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/></svg></span>
                  ¿Cómo prefieres pagar? *
                </p>
                <div id="grupoPago" class="flex flex-wrap gap-2.5">
                  <button type="button" class="cot-seg" data-val="Contado">Contado</button>
                  <button type="button" class="cot-seg" data-val="Hasta en 3 cuotas">Hasta en 3 cuotas</button>
                  <button type="button" class="cot-seg" data-val="Tarjeta de débito">Tarjeta de débito</button>
                  <button type="button" class="cot-seg" data-val="Depósito / transferencia">Depósito / transferencia</button>
                </div>
                <p id="errPago" class="cot-err hidden">Cuéntanos cómo prefieres pagar.</p>
                <p class="text-[11px] text-mut dark:text-mutd mt-2">Pagos en línea vía Flow o transferencia. Emitimos boleta de honorarios: el valor es líquido (+15,25% que declara tu empresa al SII).</p>
              </div>
            </div>

            <div class="space-y-5">
              <div>
                <label class="flex items-center gap-2 font-medium text-sm md:text-base mb-2.5 text-txt dark:text-txtd" for="inpMensaje">
